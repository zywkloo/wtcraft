#!/usr/bin/env bash
set -euo pipefail

# Resolve symlinks so this works when installed as a global npm/homebrew symlink
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SELF_DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
ROOT_DIR="$(cd "${SELF_DIR}/.." && pwd)"
# WTCRAFT_TEMPLATE_DIR overrides the default; pip/Homebrew installs set this.
TEMPLATE_DIR="${WTCRAFT_TEMPLATE_DIR:-${ROOT_DIR}/templates}"

usage() {
  cat <<'EOF'
wtcraft - git-native harness helper

Usage:
  wtcraft init [--patch-agent-files] [--local]
  wtcraft patch
  wtcraft unpatch
  wtcraft lang install [--lang <code>]
  wtcraft lang remove
  wtcraft status
  wtcraft new <type/name>
  wtcraft check <worktree-path-or-name>
  wtcraft verify <worktree-path-or-name>
  wtcraft help [command]
EOF
}

usage_init() {
  cat <<'EOF'
wtcraft init [--patch-agent-files] [--local]

  Scaffold harness files into the current git repository.
  Existing files are never overwritten.

  Options:
    --patch-agent-files   Append a wtcraft routing stub to CLAUDE.md and
                          AGENTS.md (opt-in only; never overwrites content)
    --local               Keep wtcraft scaffold local to this clone by
                          writing ignore rules to .git/info/exclude instead
                          of modifying the repo's .gitignore

  Creates:
    .agent-harness/planner.md
    .agent-harness/executor.md
    .agent-harness/finisher.md
    .agent-harness/role-models.yml
    .agent-harness/presets/
    .claude/commands/planwt.md
    .claude/commands/finishwt.md
EOF
}

usage_patch() {
  cat <<'EOF'
wtcraft patch

  Explicit alias for `wtcraft init --patch-agent-files`.
  Scaffolds harness files (if missing) and appends the managed wtcraft
  routing stub to CLAUDE.md and AGENTS.md. Idempotent and append-only:
  existing content is never overwritten, and re-running is a no-op.

  Reverse with: wtcraft unpatch
EOF
}

usage_unpatch() {
  cat <<'EOF'
wtcraft unpatch

  Remove the managed wtcraft routing stub previously added by
  `wtcraft patch` (or `init --patch-agent-files`) from CLAUDE.md and
  AGENTS.md. Only the content between the wtcraft markers is removed;
  the rest of each file is left untouched. Scaffolded harness files
  (.agent-harness/, .claude/commands/) are NOT removed.
EOF
}

usage_lang() {
  cat <<'EOF'
wtcraft lang install [--lang <code>]
wtcraft lang remove

  Install or remove a language-enforcement stub in CLAUDE.md.
  The stub instructs the AI to respond only in the specified language.

  Subcommands:
    install   Append a language-enforcement block to CLAUDE.md (idempotent)
    remove    Strip the language-enforcement block from CLAUDE.md

  Options for install:
    --lang <code>   Language to enforce (default: en)
                    en     — English only
                    zh-CN  — Simplified Chinese or English

  This stub is separate from the wtcraft routing stub (wtcraft patch/unpatch)
  and is an opt-in feature for users who need strict language output control.
EOF
}

usage_status() {
  cat <<'EOF'
wtcraft status

  List active worktree task files and their frontmatter metadata.
  Shows: task file path, status, agent, and priority.
EOF
}

usage_new() {
  cat <<'EOF'
wtcraft new <type/name>

  Create a new git worktree from the base branch and seed it with a
  .worktree-task.md contract file.

  Arguments:
    <type/name>   Branch and worktree path (e.g. feat/auth-refactor)

  Environment:
    WTCRAFT_BASE_BRANCH   Base branch to branch from (default: develop)
EOF
}

usage_check() {
  cat <<'EOF'
wtcraft check <worktree-path-or-name>

  Compare files changed in the worktree against the Scope and Off-limits
  sections of the .worktree-task.md contract. Covers commits since the base
  branch, staged/unstaged edits, and untracked files. The task contract
  itself (.worktree-task.md) is exempt.

  Scope pattern syntax:
    - Exact file path:      src/index.ts
    - Directory prefix:     src/components  (matches anything under it)
    - Glob (* any chars):   *.md, src/*.ts  (* matches path separators too)
    - Recursive glob:       src/**/*.ts

  Exit codes:
    0   No violations detected
    2   One or more Scope or Off-limits violations found
EOF
}

usage_verify() {
  cat <<'EOF'
wtcraft verify <worktree-path-or-name>

  Run verification commands listed in the Verification section of the
  .worktree-task.md contract. Each command runs inside the worktree directory.

  Output includes per-command timing, exit codes, and a summary table.
  The result is written back to the task file frontmatter as
  `verify_result: pass|fail` and `verified: <timestamp>`, which
  `wtcraft status` reports in its Verified column.

  Exit codes:
    0   All commands passed
    3   One or more commands failed
EOF
}

cmd_help() {
  if [ $# -eq 0 ]; then
    usage
    return 0
  fi
  case "$1" in
    init)    usage_init ;;
    patch)   usage_patch ;;
    unpatch) usage_unpatch ;;
    lang)    usage_lang ;;
    status)  usage_status ;;
    new)     usage_new ;;
    check)   usage_check ;;
    verify)  usage_verify ;;
    help)    usage ;;
    *) die "no help topic for: $1" ;;
  esac
}

die() {
  echo "Error: $*" >&2
  exit 1
}

ensure_repo_root() {
  git rev-parse --show-toplevel >/dev/null 2>&1 || die "not inside a git repository"
}

copy_if_missing() {
  local src="$1"
  local dst="$2"
  if [ -e "$dst" ]; then
    return 0
  fi
  mkdir -p "$(dirname "$dst")"
  cp "$src" "$dst"
}

append_managed_block_if_missing() {
  local file="$1"
  local block="$2"
  local start_marker="$3"

  if [ ! -f "$file" ]; then
    mkdir -p "$(dirname "$file")"
    printf "%s\n" "$block" >"$file"
    echo "Created and patched: ${file}"
    return 0
  fi

  if grep -qF "$start_marker" "$file"; then
    echo "Already patched: ${file}"
    return 0
  fi

  printf "\n%s\n" "$block" >>"$file"
  echo "Patched: ${file}"
}

patch_agent_files() {
  local repo_root="$1"
  local claude_file="${repo_root}/CLAUDE.md"
  local agents_file="${repo_root}/AGENTS.md"

  local claude_start="<!-- wtcraft:claude:start -->"
  local agents_start="<!-- wtcraft:agents:start -->"

  local claude_block
  claude_block="$(cat <<'EOF'
<!-- wtcraft:claude:start -->
## wtcraft routing
For complex or parallel tasks, read `.agent-harness/planner.md`.
For worktree finishing, read `.agent-harness/finisher.md`.
For LLM prompting anti-patterns (e.g., Irony of Negation, Sycophancy), read `.agent-harness/llm-anti-patterns.md`.
<!-- wtcraft:claude:end -->
EOF
)"

  local agents_block
  agents_block="$(cat <<'EOF'
<!-- wtcraft:agents:start -->
## wtcraft routing
If `.worktree-task.md` exists in the current worktree root, read `.agent-harness/executor.md` first and follow task Scope, Off-limits, and Verification.
<!-- wtcraft:agents:end -->
EOF
)"

  append_managed_block_if_missing "$claude_file" "$claude_block" "$claude_start"
  append_managed_block_if_missing "$agents_file" "$agents_block" "$agents_start"
}

remove_managed_block() {
  local file="$1"
  local start_marker="$2"
  local end_marker="$3"

  if [ ! -f "$file" ]; then
    echo "Not found (skipped): ${file}"
    return 0
  fi

  if ! grep -qF "$start_marker" "$file"; then
    echo "No wtcraft stub (skipped): ${file}"
    return 0
  fi

  local tmp
  tmp="$(mktemp)"
  # Drop every line from the start marker through the end marker (inclusive).
  # Lines are buffered one behind so we can also discard the single blank
  # separator line the appender inserts before the block.
  awk -v s="$start_marker" -v e="$end_marker" '
    index($0, s) {
      if (have_prev && prev !~ /^[[:space:]]*$/) print prev
      have_prev = 0
      skip = 1
      next
    }
    skip {
      if (index($0, e)) skip = 0
      next
    }
    { if (have_prev) print prev; prev = $0; have_prev = 1 }
    END { if (have_prev) print prev }
  ' "$file" >"$tmp"

  mv "$tmp" "$file"
  echo "Unpatched: ${file}"
}

unpatch_agent_files() {
  local repo_root="$1"
  remove_managed_block "${repo_root}/CLAUDE.md" \
    "<!-- wtcraft:claude:start -->" "<!-- wtcraft:claude:end -->"
  remove_managed_block "${repo_root}/AGENTS.md" \
    "<!-- wtcraft:agents:start -->" "<!-- wtcraft:agents:end -->"
}

cmd_init() {
  ensure_repo_root
  local patch_agent=false
  local local_mode=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --patch-agent-files) patch_agent=true ;;
      --local) local_mode=true ;;
      *) die "unknown init option: $1" ;;
    esac
    shift
  done

  local repo_root
  repo_root="$(git rev-parse --show-toplevel)"

  copy_if_missing "${TEMPLATE_DIR}/.agent-harness/planner.md" "${repo_root}/.agent-harness/planner.md"
  copy_if_missing "${TEMPLATE_DIR}/.agent-harness/executor.md" "${repo_root}/.agent-harness/executor.md"
  copy_if_missing "${TEMPLATE_DIR}/.agent-harness/finisher.md" "${repo_root}/.agent-harness/finisher.md"
  copy_if_missing "${TEMPLATE_DIR}/.agent-harness/role-models.yml" "${repo_root}/.agent-harness/role-models.yml"
  copy_if_missing "${TEMPLATE_DIR}/.agent-harness/llm-anti-patterns.md" "${repo_root}/.agent-harness/llm-anti-patterns.md"
  copy_if_missing "${TEMPLATE_DIR}/.claude/commands/planwt.md" "${repo_root}/.claude/commands/planwt.md"
  copy_if_missing "${TEMPLATE_DIR}/.claude/commands/finishwt.md" "${repo_root}/.claude/commands/finishwt.md"
  copy_if_missing "${TEMPLATE_DIR}/.claude/commands/statuswt.md" "${repo_root}/.claude/commands/statuswt.md"
  
  for preset in balanced anthropic openai google; do
    copy_if_missing "${TEMPLATE_DIR}/.agent-harness/presets/preset-${preset}.yml" "${repo_root}/.agent-harness/presets/preset-${preset}.yml"
  done

  if [ "$local_mode" = true ]; then
    local exclude_file="${repo_root}/.git/info/exclude"
    mkdir -p "$(dirname "$exclude_file")"
    [ -f "$exclude_file" ] || : >"$exclude_file"
    if ! grep -qxF '# wtcraft local scaffold' "$exclude_file"; then
      printf '\n# wtcraft local scaffold\n' >>"$exclude_file"
    fi
    local local_rule
    for local_rule in \
      '/.worktree-task.md' \
      '/.agent-harness/' \
      '/.claude/commands/' \
      '/AGENTS.md' \
      '/CLAUDE.md'
    do
      if ! grep -qxF "$local_rule" "$exclude_file"; then
        printf '%s\n' "$local_rule" >>"$exclude_file"
      fi
    done
  else
    # Ensure .worktree-task.md is ignored in the user's repo
    local gitignore="${repo_root}/.gitignore"
    if [ ! -f "$gitignore" ] || ! grep -qxF '/.worktree-task.md' "$gitignore"; then
      printf '\n# wtcraft local task state\n/.worktree-task.md\n' >> "$gitignore"
    fi
  fi

  cat <<'EOF'
 Initialized wtcraft harness files (existing files were left untouched):
   .agent-harness/planner.md
   .agent-harness/executor.md
   .agent-harness/finisher.md
   .agent-harness/role-models.yml
   .agent-harness/llm-anti-patterns.md
   .agent-harness/presets/
   .claude/commands/planwt.md
   .claude/commands/finishwt.md
   .claude/commands/statuswt.md
EOF

  if [ "$patch_agent" = true ]; then
    echo
    echo "Applying optional routing stubs to agent files..."
    patch_agent_files "$repo_root"
  else
    echo
    echo "Agent files were not modified (default behavior)."
    echo "Use: wtcraft init --patch-agent-files"
  fi

  if [ "$local_mode" = true ]; then
    echo
    echo "Local mode enabled: wtcraft scaffold is ignored via .git/info/exclude in this clone only."
  fi
}

cmd_patch() {
  [ $# -eq 0 ] || die "patch takes no arguments"
  cmd_init --patch-agent-files
}

cmd_unpatch() {
  [ $# -eq 0 ] || die "unpatch takes no arguments"
  ensure_repo_root
  local repo_root
  repo_root="$(git rev-parse --show-toplevel)"
  echo "Removing wtcraft routing stubs from agent files..."
  unpatch_agent_files "$repo_root"
}

cmd_lang() {
  [ $# -ge 1 ] || { usage_lang; exit 1; }
  local subcmd="$1"; shift
  ensure_repo_root
  local repo_root
  repo_root="$(git rev-parse --show-toplevel)"
  local claude_file="${repo_root}/CLAUDE.md"

  case "$subcmd" in
    install)
      local lang="en"
      while [ $# -gt 0 ]; do
        case "$1" in
          --lang) shift; lang="${1:?--lang requires a value}"; shift ;;
          *) die "unknown lang install option: $1" ;;
        esac
      done

      local lang_block
      case "$lang" in
        en)
          lang_block="$(cat <<'EOF'
<!-- wtcraft:lang:start -->
## Language Enforcement
CRITICAL: Output YOUR ENTIRE RESPONSE in **English** only.
<!-- wtcraft:lang:end -->
EOF
)"
          ;;
        zh-CN)
          lang_block="$(cat <<'EOF'
<!-- wtcraft:lang:start -->
## Language Enforcement
CRITICAL: Output YOUR ENTIRE RESPONSE in **Simplified Chinese (简体中文)** or English only.
<!-- wtcraft:lang:end -->
EOF
)"
          ;;
        *)
          die "unsupported language code: ${lang}. Supported: en, zh-CN"
          ;;
      esac

      append_managed_block_if_missing "$claude_file" "$lang_block" "<!-- wtcraft:lang:start -->"
      ;;
    remove)
      [ $# -eq 0 ] || die "lang remove takes no arguments"
      remove_managed_block "$claude_file" \
        "<!-- wtcraft:lang:start -->" "<!-- wtcraft:lang:end -->"
      ;;
    *)
      die "unknown lang subcommand: ${subcmd}. Use install or remove"
      ;;
  esac
}

extract_frontmatter() {
  local file="$1"
  local key="$2"
  awk -v key="$key" '
    BEGIN { in_fm=0 }
    /^---$/ {
      if (in_fm==0) { in_fm=1; next }
      else { in_fm=0; exit }
    }
    in_fm==1 {
      if ($0 ~ "^" key ":") {
        sub("^" key ":[[:space:]]*", "", $0)
        print $0
        exit
      }
    }
  ' "$file"
}

# set_frontmatter <file> <key> <value>
#
# Update key in the frontmatter block, or insert it before the closing ---
# when absent. Only the first frontmatter block is touched.
set_frontmatter() {
  local file="$1"
  local key="$2"
  local value="$3"
  local tmp="${file}.tmp"
  awk -v key="$key" -v value="$value" '
    BEGIN { in_fm=0; fm_done=0; written=0 }
    /^---$/ {
      if (fm_done==0 && in_fm==0) { in_fm=1; print; next }
      if (in_fm==1) {
        if (written==0) { print key ": " value; written=1 }
        in_fm=0; fm_done=1; print; next
      }
      print; next
    }
    in_fm==1 && written==0 && $0 ~ "^" key ":" { print key ": " value; written=1; next }
    { print }
  ' "$file" > "$tmp" && mv "$tmp" "$file"
}

cmd_status() {
  ensure_repo_root
  local repo_root
  repo_root="$(git rev-parse --show-toplevel)"

  printf "%-45s %-12s %-10s %-8s %-10s\n" "Task File" "Status" "Agent" "Priority" "Verified"
  printf "%-45s %-12s %-10s %-8s %-10s\n" "---------" "------" "-----" "--------" "--------"

  local found=0
  while IFS= read -r wt; do
    [ -z "$wt" ] && continue
    # Skip the primary worktree (repo root), keep only linked worktrees.
    [ "$wt" = "$repo_root" ] && continue
    local task rel status agent priority verified
    task="${wt}/.worktree-task.md"
    [ -f "$task" ] || continue
    found=1
    rel="${task#"${repo_root}"/}"
    status="$(extract_frontmatter "$task" "status")"
    agent="$(extract_frontmatter "$task" "agent")"
    priority="$(extract_frontmatter "$task" "priority")"
    verified="$(extract_frontmatter "$task" "verify_result")"
    status="${status:-unknown}"
    agent="${agent:-unknown}"
    priority="${priority:-unknown}"
    verified="${verified:--}"
    printf "%-45s %-12s %-10s %-8s %-10s\n" "$rel" "$status" "$agent" "$priority" "$verified"
  done < <(git -C "$repo_root" worktree list --porcelain | awk '/^worktree /{sub(/^worktree /,"",$0); print}')

  if [ "$found" -eq 0 ]; then
    echo "No worktree task files found under worktrees/."
  fi
}

cmd_new() {
  ensure_repo_root
  [ $# -eq 1 ] || die "new expects exactly one argument: <type/name>"
  local branch="$1"
  local repo_root base_branch wt_path
  repo_root="$(git rev-parse --show-toplevel)"
  base_branch="${WTCRAFT_BASE_BRANCH:-develop}"
  wt_path="${repo_root}/worktrees/${branch}"

  [ ! -e "$wt_path" ] || die "worktree path already exists: ${wt_path}"
  git -C "$repo_root" show-ref --verify --quiet "refs/heads/${branch}" && die "branch already exists: ${branch}"

  mkdir -p "${repo_root}/worktrees"
  git -C "$repo_root" worktree add "$wt_path" -b "$branch" "$base_branch"

  local task_file="${wt_path}/.worktree-task.md"

  # If /planwt already generated a plan in the repo root, absorb it;
  # otherwise seed with the blank template.
  if [ -f "${repo_root}/.worktree-task.md" ]; then
    mv "${repo_root}/.worktree-task.md" "$task_file"
  else
    cp "${TEMPLATE_DIR}/worktrees/.worktree-task.md" "$task_file"
  fi

  local today
  today="$(date +%F)"
  sed -i.bak "s|^branch: .*|branch: ${branch}|" "$task_file"
  sed -i.bak "s|^created: .*|created: ${today}|" "$task_file"
  sed -i.bak "s|^base: .*|base: ${base_branch}|" "$task_file"
  rm -f "${task_file}.bak"

  cat <<EOF
Created worktree:
  ${wt_path}
Created task contract:
  ${task_file}
EOF
}

collect_section_items() {
  local file="$1"
  local section="$2"
  awk -v section="$section" '
    BEGIN { in_section=0 }
    $0 ~ "^##[[:space:]]+" section "$" { in_section=1; next }
    in_section==1 && $0 ~ "^##[[:space:]]+" { in_section=0 }
    in_section==1 {
      line=$0
      gsub(/^[[:space:]]*-[[:space:]]*/, "", line)
      gsub(/`/, "", line)
      gsub(/[[:space:]]+$/, "", line)
      if (line != "" && line !~ /^#/) print line
    }
  ' "$file"
}

collect_verification_commands() {
  local file="$1"
  awk '
    BEGIN { in_section=0 }
    /^##[[:space:]]+Verification$/ { in_section=1; next }
    in_section==1 && /^##[[:space:]]+/ { in_section=0 }
    in_section==1 {
      line=$0
      if (line ~ /^[[:space:]]*-[[:space:]]*\[[ xX]\][[:space:]]+/) {
        sub(/^[[:space:]]*-[[:space:]]*\[[ xX]\][[:space:]]+/, "", line)
        gsub(/`/, "", line)
        gsub(/[[:space:]]+$/, "", line)
        if (line != "") print line
      }
    }
  ' "$file"
}

resolve_worktree_path() {
  local arg="$1"
  if [ -d "$arg" ]; then
    (cd "$arg" && pwd)
    return 0
  fi
  local repo_root
  repo_root="$(git rev-parse --show-toplevel)"
  if [ -d "${repo_root}/worktrees/${arg}" ]; then
    echo "${repo_root}/worktrees/${arg}"
    return 0
  fi
  return 1
}

# file_matches_scope_item <file> <pattern>
#
# Returns 0 (match) when the file path satisfies the pattern, 1 otherwise.
#
# Pattern types:
#   No wildcard  — exact match OR directory-prefix match (pattern/ prefix)
#   With *       — bash glob matching; * matches any chars including '/'
#                  so src/*.ts also matches src/sub/dir/file.ts
#                  and *.md matches docs/readme.md at any depth
file_matches_scope_item() {
  local file="$1"
  local pattern="$2"
  [ -z "$pattern" ] && return 1

  # No wildcards: exact or directory-prefix match (original behaviour)
  if [[ "$pattern" != *"*"* ]]; then
    [ "$file" = "$pattern" ] && return 0
    [[ "$file" == "$pattern/"* ]] && return 0
    return 1
  fi

  # Glob pattern: in bash [[ ]], * matches any characters including '/'
  # This makes src/*.ts, src/**/*.ts, and *.md all work as expected.
  # shellcheck disable=SC2053
  [[ "$file" == $pattern ]] && return 0
  return 1
}

cmd_check() {
  ensure_repo_root
  [ $# -eq 1 ] || die "check expects exactly one argument"
  local wt_path
  wt_path="$(resolve_worktree_path "$1")" || die "worktree not found: $1"

  local task_file="${wt_path}/.worktree-task.md"
  [ -f "$task_file" ] || die "missing task file: ${task_file}"

  local base_branch
  base_branch="$(extract_frontmatter "$task_file" "base")"
  base_branch="${base_branch:-develop}"

  local changed_files=()
  local scope_items=()
  local offlimits_items=()
  local line

  # Committed changes vs base, plus staged/unstaged edits and untracked files —
  # agents often leave work uncommitted, and a gate that only sees commits has a hole.
  while IFS= read -r line; do
    changed_files+=("$line")
  done < <(
    {
      git -C "$wt_path" diff --name-only "${base_branch}...HEAD"
      git -C "$wt_path" diff --name-only HEAD
      git -C "$wt_path" ls-files --others --exclude-standard
    } | sort -u
  )

  while IFS= read -r line; do
    scope_items+=("$line")
  done < <(collect_section_items "$task_file" "Scope")

  while IFS= read -r line; do
    offlimits_items+=("$line")
  done < <(collect_section_items "$task_file" "Off-limits")

  local has_violations=0

  for f in "${changed_files[@]:-}"; do
    [ -z "$f" ] && continue
    if [ "$f" = ".worktree-task.md" ]; then
      echo "Task contract violation: .worktree-task.md is local worktree state and must not be committed or merged."
      has_violations=1
      continue
    fi

    local in_scope=0
    for s in "${scope_items[@]:-}"; do
      [ -z "$s" ] && continue
      if file_matches_scope_item "$f" "$s"; then
        in_scope=1
        break
      fi
    done
    if [ "${#scope_items[@]}" -gt 0 ] && [ "$in_scope" -eq 0 ]; then
      echo "Scope violation: ${f}"
      has_violations=1
    fi

    for o in "${offlimits_items[@]:-}"; do
      [ -z "$o" ] && continue
      if file_matches_scope_item "$f" "$o"; then
        echo "Off-limits violation: ${f} (matched ${o})"
        has_violations=1
      fi
    done
  done

  if [ "$has_violations" -eq 0 ]; then
    echo "Check passed: no Scope/Off-limits violations in commits since ${base_branch} or the working tree."
  else
    exit 2
  fi
}

cmd_verify() {
  ensure_repo_root
  [ $# -eq 1 ] || die "verify expects exactly one argument"
  local wt_path
  wt_path="$(resolve_worktree_path "$1")" || die "worktree not found: $1"

  local task_file="${wt_path}/.worktree-task.md"
  [ -f "$task_file" ] || die "missing task file: ${task_file}"

  local commands=()
  local line
  while IFS= read -r line; do
    commands+=("$line")
  done < <(collect_verification_commands "$task_file")

  if [ "${#commands[@]}" -eq 0 ]; then
    die "no verification commands found in ${task_file}"
  fi

  local failures=0
  local total="${#commands[@]}"
  local result_lines=()
  local i=0

  for cmd in "${commands[@]}"; do
    i=$((i + 1))
    local start=$SECONDS
    echo ""
    echo "[${i}/${total}] Running: ${cmd}"
    echo "----------------------------------------------------------------"
    set +e
    (cd "$wt_path" && bash -lc "$cmd")
    local exit_code=$?
    set -e
    local elapsed=$((SECONDS - start))
    echo "----------------------------------------------------------------"
    if [ "$exit_code" -ne 0 ]; then
      failures=$((failures + 1))
      echo "FAILED (exit ${exit_code}, ${elapsed}s)"
      result_lines+=("  FAIL  [exit ${exit_code}] (${elapsed}s)  ${cmd}")
    else
      echo "PASSED (${elapsed}s)"
      result_lines+=("  PASS  [exit 0]       (${elapsed}s)  ${cmd}")
    fi
  done

  echo ""
  echo "================================================================"
  echo "Verification summary: $((total - failures)) passed, ${failures} failed of ${total}"
  echo "================================================================"
  for r in "${result_lines[@]}"; do
    echo "$r"
  done
  echo "================================================================"

  local result="pass"
  [ "$failures" -ne 0 ] && result="fail"
  set_frontmatter "$task_file" "verify_result" "$result"
  set_frontmatter "$task_file" "verified" "$(date +"%Y-%m-%d %H:%M")"
  echo "Recorded verify_result: ${result} in ${task_file}"

  if [ "$failures" -ne 0 ]; then
    echo ""
    echo "Verification FAILED: ${failures} of ${total} command(s) failed."
    exit 3
  fi

  echo ""
  echo "Verification PASSED: all ${total} command(s) succeeded."
}

main() {
  [ $# -ge 1 ] || { usage; exit 1; }
  local cmd="$1"
  shift

  case "$cmd" in
    init)        cmd_init "$@" ;;
    patch)       cmd_patch "$@" ;;
    unpatch)     cmd_unpatch "$@" ;;
    lang)        cmd_lang "$@" ;;
    status)      cmd_status "$@" ;;
    new)         cmd_new "$@" ;;
    check)       cmd_check "$@" ;;
    verify)      cmd_verify "$@" ;;
    help)        cmd_help "$@" ;;
    -h|--help)   usage ;;
    *) usage; die "unknown command: ${cmd}" ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
