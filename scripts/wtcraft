#!/usr/bin/env bash
set -euo pipefail

# Resolve symlinks so this works when installed as a global npm/homebrew symlink
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SELF_DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
ROOT_DIR="$(cd "${SELF_DIR}/.." && pwd)"
# WTCRAFT_TEMPLATE_DIR overrides the default; pip/Homebrew installs set this.
TEMPLATE_DIR="${WTCRAFT_TEMPLATE_DIR:-${ROOT_DIR}/templates}"

usage() {
  cat <<'EOF'
wtcraft - git-native harness helper

Usage:
  wtcraft agent init [--path <path>]
  wtcraft init [--patch-agent-files] [--local] [--repo <path>]
  wtcraft init-ci [--repo <path>] [--force]
  wtcraft patch [--repo <path>]
  wtcraft unpatch [--repo <path>]
  wtcraft lang install [--repo <path>] [--lang <code>]
  wtcraft lang remove [--repo <path>]
  wtcraft status [--json] [--repo <path>]
  wtcraft state [--json] [--repo <path>] <worktree> [--stage <stage>] [--role <role>] [--agent <agent>]
  wtcraft new [--repo <path>] <type/name>
  wtcraft check [--json] [--repo <path>] <worktree-path-or-name>
  wtcraft verify [--json] [--repo <path>] <worktree-path-or-name>
  wtcraft capabilities --json
  wtcraft doctor
  wtcraft migrate [--yes]
  wtcraft --version
  wtcraft help [command]
EOF
}

usage_agent() {
  cat <<'EOF'
wtcraft agent init [--path <path>]

  Initialize shared coding-agent instructions in a project directory.
  Git is not required.

  AGENTS.md is the canonical instruction file. CLAUDE.md imports it with
  @AGENTS.md so shared instructions only need to be maintained once.
  Existing content is never overwritten, and re-running is idempotent.

  Options:
    --path <path>   Target a project directory instead of the current one

  Creates when missing:
    AGENTS.md
    CLAUDE.md
EOF
}

usage_init() {
  cat <<'EOF'
wtcraft init [--patch-agent-files] [--local] [--repo <path>]

  Scaffold harness files into the current project directory.
  Git is not required unless --local is used.
  Existing files are never overwritten.

  Options:
    --patch-agent-files   Append a wtcraft routing stub to CLAUDE.md and
                          AGENTS.md so agents auto-read .agent-harness/
                          (opt-in only; never overwrites existing content)
    --local               Keep wtcraft scaffold local to this clone by
                          writing ignore rules to .git/info/exclude instead
                          of modifying the repo's .gitignore
    --repo <path>         Target a specific project directory instead of relying
                          on the current working directory

  Creates:
    .agent-harness/planner.md
    .agent-harness/executor.md
    .agent-harness/finisher.md
    .agent-harness/role-models.yml
    .agent-harness/task-states.md
    .agent-harness/presets/
    .claude/commands/planwt.md
    .claude/commands/finishwt.md
    .claude/commands/statuswt.md
    .agents/skills/planwt/SKILL.md
    .agents/skills/finishwt/SKILL.md
    .agents/skills/statuswt/SKILL.md

  Routing is opt-in:
    Without --patch-agent-files, AGENTS.md and CLAUDE.md are left untouched, so
    agents have no pointer to .agent-harness/ and will not read it
    automatically. The .claude/commands and .agents/skills entry points still
    work when invoked explicitly (each reads .agent-harness/ itself).
    Use `wtcraft init --patch-agent-files` (or `wtcraft patch`) to wire routing.
EOF
}

usage_init_ci() {
  cat <<'EOF'
wtcraft init-ci [--repo <path>] [--force]

  Install the trusted-change-authorization check into a Git repository.

  Writes a pull_request_target workflow plus the policy evaluator it runs.
  The adapter is vendored because the job must not install anything: it runs
  privileged, from the trusted base checkout, and never reads the pull
  request's own copy.

  Existing files are left untouched. A vendored file that differs from this
  wtcraft version is reported, not overwritten -- a stale copy silently keeps
  bugs this version fixed. Use --force to replace it.

  Installing the check does not enforce it. Creating and protecting
  refs/heads/wtcraft-policy and marking the check required are repository
  administration; the command prints the remaining steps.

  Options:
    --repo <path>   Target a repository other than the current one
    --force         Replace vendored files that differ from this version

  Creates when missing:
    .github/workflows/wtcraft-trusted-change.yml
    .wtcraft/policy_evaluator.py
    .wtcraft/policy_git_adapter.py
EOF
}

usage_patch() {
  cat <<'EOF'
wtcraft patch [--repo <path>]

  Explicit alias for `wtcraft init --patch-agent-files`.
  Scaffolds harness files (if missing) and appends the managed wtcraft
  routing stub to CLAUDE.md and AGENTS.md. Idempotent and append-only:
  existing content is never overwritten, and re-running is a no-op.

  Reverse with: wtcraft unpatch
EOF
}

usage_unpatch() {
  cat <<'EOF'
wtcraft unpatch [--repo <path>]

  Remove the managed wtcraft routing stub previously added by
  `wtcraft patch` (or `init --patch-agent-files`) from CLAUDE.md and
  AGENTS.md. Only the content between the wtcraft markers is removed;
  the rest of each file is left untouched. Scaffolded harness files
  (.agent-harness/, .claude/commands/) are NOT removed.
EOF
}

usage_lang() {
  cat <<'EOF'
wtcraft lang install [--repo <path>] [--lang <code>]
wtcraft lang remove [--repo <path>]

  Install or remove a language-enforcement stub in the agent files
  (CLAUDE.md and AGENTS.md). The stub instructs the AI to respond only
  in the specified language.

  Only agent files that already exist are patched; this command never
  creates one. If neither CLAUDE.md nor AGENTS.md exists, run
  'wtcraft agent init' first to create them.

  Subcommands:
    install   Append a language-enforcement block to each existing
              agent file (idempotent)
    remove    Strip the language-enforcement block from both agent files

  Options for install:
    --lang <code>   Language to enforce (default: en)
                    en     — English only
                    zh-CN  — Simplified Chinese or English

  This stub is separate from the wtcraft routing stub (wtcraft patch/unpatch)
  and is an opt-in feature for users who need strict language output control.
EOF
}

usage_status() {
  cat <<'EOF'
wtcraft status [--json] [--repo <path>]

  List all linked worktrees with their task specification and sidecar state. Worktrees are
  enumerated via `git worktree list`, so any layout is covered (in-repo
  worktrees/, sibling dirs, agent-created arbitrary paths).

  --json emits one object per worktree: worktree, branch, zombie, locked,
  contracted, and (when contracted) task_file, state_file, stage (with legacy
  task-frontmatter fallback applied), role, agent, status, attempt, handoff,
  check/verify results and timestamps, priority, created, base, ready, and
  evidence_stale. Absent fields are null. Intended as the stable machine
  interface for external observers/GUIs.
  --repo <path> explicitly targets a repository; registry commands normalize
  linked worktrees to the repository's primary worktree root.

  Columns: task file, stage, role, agent, priority, verification result.
  Lifecycle and results come from `.worktree-state.json`; legacy task
  frontmatter remains a read-only fallback during migration.

  Worktrees without a `.worktree-task.md` are listed as `uncontracted`;
  registry entries whose directory was deleted show as `zombie`.
EOF
}

usage_state() {
  cat <<'EOF'
wtcraft state [--json] [--repo <path>] <worktree-path-or-name> [updates]

  Update mutable coordination facts in `.worktree-state.json`. This command
  never rewrites `.worktree-task.md`, which remains the task specification.

  Updates (at least one required):
    --stage <stage>          planned|executing|verifying|replan|approved|finishing|done
    --role <role>            planner|executor|verifier|finisher|none
    --agent <agent>          Assigned CLI/provider name
    --attempt <number>       Non-negative attempt counter
    --handoff-from <agent>   Previous CLI/provider, or "none" to clear
    --handoff-to <agent>     Next CLI/provider, or "none" to clear

  This is local coordination state, not an authorization or security boundary.
EOF
}

usage_new() {
  cat <<'EOF'
wtcraft new [--repo <path>] [--base <branch>] <type/name>

  Create a new git worktree from the base branch and seed it with a
  `.worktree-task.md` task specification plus `.worktree-state.json` sidecar.

  Arguments:
    <type/name>   Branch and worktree path (e.g. feat/auth-refactor)

  Options:
    --repo <path>    Target a specific repository explicitly
    --base <branch>  Override the base branch/ref for this worktree creation

  Environment:
    WTCRAFT_BASE_BRANCH   Base branch/ref to branch from when --base is not
                          provided

  Default base detection:
    1. `origin/HEAD`
    2. local `main`
    3. local `master`
    4. local `develop`
    5. current branch
EOF
}

usage_check() {
  cat <<'EOF'
wtcraft check [--json] [--repo <path>] <worktree-path-or-name>

  Compare files changed in the worktree against the Scope and Off-limits
  sections of the `.worktree-task.md` task specification. Covers commits since
  the base branch, staged/unstaged edits, and untracked files. Local task files
  are exempt when untracked; force-committing either one is a violation.

  Scope pattern syntax:
    - Exact file path:      src/index.ts
    - Directory prefix:     src/components  (matches anything under it)
    - Glob (* any chars):   *.md, src/*.ts  (* matches path separators too)
    - Recursive glob:       src/**/*.ts

  Exit codes:
    0   No violations detected
    2   One or more Scope or Off-limits violations found

  --json emits a stable machine-readable object to stdout while preserving
  the same exit codes. Diagnostics remain on stderr.
EOF
}

usage_verify() {
  cat <<'EOF'
wtcraft verify [--json] [--repo <path>] <worktree-path-or-name>

  Run verification commands listed in the Verification section of the
  `.worktree-task.md` task specification. Each command runs inside the worktree directory.

  Output includes per-command timing, exit codes, and a summary table.
  The result, timestamp, and worktree snapshot are written to
  `.worktree-state.json`, which `wtcraft status` reports without mutating the
  task specification.

  Exit codes:
    0   All commands passed
    3   One or more commands failed

  --json emits a stable machine-readable object to stdout while preserving
  the same exit codes. Verification command output remains on stderr.
EOF
}

usage_capabilities() {
  cat <<'EOF'
wtcraft capabilities --json

  Report the machine-protocol features supported by this wtcraft build.
  The current output format is JSON-only and is intended for GUI/TUI
  launchers that need capability discovery before invocation.
EOF
}

usage_doctor() {
  cat <<'EOF'
wtcraft doctor

  Diagnose the current wtcraft installation and repository scaffold.

  Reports:
    - CLI path and version
    - other wtcraft installations on PATH (shadow detection)
    - scaffold file completeness (when inside a git repository)
    - legacy file detection (.worktree-task.template.md)
    - template directory status
    - git credential helper
EOF
}

usage_migrate() {
  cat <<'EOF'
wtcraft migrate [--yes]

  Ensure all scaffold files are present and remove legacy files.

  Runs `wtcraft init` to fill in any missing scaffold, then offers to
  delete known legacy files such as .worktree-task.template.md.

  Options:
    --yes   Skip the interactive confirmation prompt and delete legacy
            files automatically. Useful for CI and scripted usage.
EOF
}

cmd_help() {
  if [ $# -eq 0 ]; then
    usage
    return 0
  fi
  case "$1" in
    agent)   usage_agent ;;
    init)    usage_init ;;
    init-ci) usage_init_ci ;;
    patch)   usage_patch ;;
    unpatch) usage_unpatch ;;
    lang)    usage_lang ;;
    status)  usage_status ;;
    state)   usage_state ;;
    new)     usage_new ;;
    check)   usage_check ;;
    verify)  usage_verify ;;
    capabilities) usage_capabilities ;;
    doctor)  usage_doctor ;;
    migrate) usage_migrate ;;
    version) usage ;;
    help)    usage ;;
    *) die "no help topic for: $1" ;;
  esac
}

die() {
  echo "Error: $*" >&2
  exit 1
}

read_cli_version() {
  # Installers stamp WTCRAFT_VERSION (brew wrapper, pip _cli.py) so the version
  # survives even when no manifest sits beside the installed script.
  if [ -n "${WTCRAFT_VERSION:-}" ]; then
    printf '%s' "${WTCRAFT_VERSION}"
    return 0
  fi
  # In-repo development: read it straight from the manifest next to the script.
  if [ -f "${ROOT_DIR}/package.json" ]; then
    awk -F'"' '/"version"[[:space:]]*:/ { print $4; exit }' "${ROOT_DIR}/package.json"
    return 0
  fi
  if [ -f "${ROOT_DIR}/pyproject.toml" ]; then
    awk -F'"' '/^version[[:space:]]*=/ { print $2; exit }' "${ROOT_DIR}/pyproject.toml"
    return 0
  fi
  printf 'unknown'
}

current_worktree_root() {
  local path="${1:-.}"
  git -C "$path" rev-parse --show-toplevel 2>/dev/null
}

primary_worktree_root() {
  local path="${1:-.}"
  git -C "$path" worktree list --porcelain 2>/dev/null | awk '
    /^worktree / {
      sub(/^worktree /, "", $0)
      print
      exit
    }
  '
}

resolve_base_branch() {
  local repo_root="$1"
  local explicit_base="${2:-}"
  if [ -n "$explicit_base" ]; then
    printf '%s' "$explicit_base"
    return 0
  fi

  if [ -n "${WTCRAFT_BASE_BRANCH:-}" ]; then
    printf '%s' "${WTCRAFT_BASE_BRANCH}"
    return 0
  fi

  local candidate
  candidate="$(git -C "$repo_root" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  if [ -n "$candidate" ]; then
    printf '%s' "$candidate"
    return 0
  fi

  for candidate in main master develop; do
    if git -C "$repo_root" show-ref --verify --quiet "refs/heads/${candidate}"; then
      printf '%s' "$candidate"
      return 0
    fi
  done

  candidate="$(git -C "$repo_root" branch --show-current 2>/dev/null || true)"
  if [ -n "$candidate" ]; then
    printf '%s' "$candidate"
    return 0
  fi

  die "could not determine a base branch; set WTCRAFT_BASE_BRANCH explicitly"
}

git_info_exclude_path() {
  local path="${1:-.}"
  git -C "$path" rev-parse --git-path info/exclude 2>/dev/null
}

ensure_git_path() {
  local path="${1:-.}"
  git -C "$path" rev-parse --show-toplevel >/dev/null 2>&1 || die "not inside a git repository: ${path}"
}

directory_root() {
  local path="${1:-.}"
  [ -d "$path" ] || die "project directory does not exist: ${path}"
  (cd "$path" && pwd -P)
}

# Resolve a project root without requiring Git. Inside a repository this keeps
# the existing behavior of targeting the worktree root; elsewhere, the target
# directory itself is the project root.
project_root() {
  local path="${1:-.}"
  [ -d "$path" ] || die "project directory does not exist: ${path}"

  local git_root
  git_root="$(git -C "$path" rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -n "$git_root" ]; then
    printf '%s' "$git_root"
  else
    directory_root "$path"
  fi
}

copy_if_missing() {
  local src="$1"
  local dst="$2"
  if [ -e "$dst" ]; then
    return 0
  fi
  mkdir -p "$(dirname "$dst")"
  cp "$src" "$dst"
}

append_managed_block_if_missing() {
  local file="$1"
  local block="$2"
  local start_marker="$3"

  if [ ! -f "$file" ]; then
    mkdir -p "$(dirname "$file")"
    printf "%s\n" "$block" >"$file"
    echo "Created and patched: ${file}"
    return 0
  fi

  if grep -qF "$start_marker" "$file"; then
    echo "Already patched: ${file}"
    return 0
  fi

  printf "\n%s\n" "$block" >>"$file"
  echo "Patched: ${file}"
}

patch_agent_files() {
  local repo_root="$1"
  local claude_file="${repo_root}/CLAUDE.md"
  local agents_file="${repo_root}/AGENTS.md"

  local claude_start="<!-- wtcraft:claude:start -->"
  local agents_start="<!-- wtcraft:agents:start -->"

  local claude_block
  claude_block="$(cat <<'EOF'
<!-- wtcraft:claude:start -->
## wtcraft routing
For complex or parallel tasks, read `.agent-harness/planner.md`.
For worktree finishing, read `.agent-harness/finisher.md`.
For LLM prompting anti-patterns (e.g., Irony of Negation, Sycophancy), read `.agent-harness/llm-anti-patterns.md`.
<!-- wtcraft:claude:end -->
EOF
)"

  local agents_block
  agents_block="$(cat <<'EOF'
<!-- wtcraft:agents:start -->
## wtcraft routing
If `.worktree-task.md` exists in the current worktree root, read `.agent-harness/executor.md` first and follow task Scope, Off-limits, and Verification.
<!-- wtcraft:agents:end -->
EOF
)"

  append_managed_block_if_missing "$claude_file" "$claude_block" "$claude_start"
  append_managed_block_if_missing "$agents_file" "$agents_block" "$agents_start"
}

remove_managed_block() {
  local file="$1"
  local start_marker="$2"
  local end_marker="$3"

  if [ ! -f "$file" ]; then
    echo "Not found (skipped): ${file}"
    return 0
  fi

  if ! grep -qF "$start_marker" "$file"; then
    echo "No wtcraft stub (skipped): ${file}"
    return 0
  fi

  local tmp
  tmp="$(mktemp)"
  # Drop every line from the start marker through the end marker (inclusive).
  # Lines are buffered one behind so we can also discard the single blank
  # separator line the appender inserts before the block.
  awk -v s="$start_marker" -v e="$end_marker" '
    index($0, s) {
      if (have_prev && prev !~ /^[[:space:]]*$/) print prev
      have_prev = 0
      skip = 1
      next
    }
    skip {
      if (index($0, e)) skip = 0
      next
    }
    { if (have_prev) print prev; prev = $0; have_prev = 1 }
    END { if (have_prev) print prev }
  ' "$file" >"$tmp"

  mv "$tmp" "$file"
  echo "Unpatched: ${file}"
}

unpatch_agent_files() {
  local repo_root="$1"
  remove_managed_block "${repo_root}/CLAUDE.md" \
    "<!-- wtcraft:claude:start -->" "<!-- wtcraft:claude:end -->"
  remove_managed_block "${repo_root}/AGENTS.md" \
    "<!-- wtcraft:agents:start -->" "<!-- wtcraft:agents:end -->"
}

cmd_agent_init() {
  local path_arg="."
  while [ $# -gt 0 ]; do
    case "$1" in
      --path) shift; path_arg="${1:?--path requires a path}" ;;
      *) die "unknown agent init option: $1" ;;
    esac
    shift
  done

  local root agents_file claude_file
  root="$(directory_root "$path_arg")"
  agents_file="${root}/AGENTS.md"
  claude_file="${root}/CLAUDE.md"

  if { [ -e "$agents_file" ] || [ -L "$agents_file" ]; } && [ ! -f "$agents_file" ]; then
    die "AGENTS.md exists but is not a regular file: ${agents_file}"
  fi
  if { [ -e "$claude_file" ] || [ -L "$claude_file" ]; } && [ ! -f "$claude_file" ]; then
    die "CLAUDE.md exists but is not a regular file: ${claude_file}"
  fi

  if [ ! -e "$agents_file" ]; then
    printf '# Project Instructions\n' >"$agents_file"
    echo "Created: ${agents_file}"
  else
    echo "Existing content preserved: ${agents_file}"
  fi

  if [ ! -e "$claude_file" ]; then
    printf '@AGENTS.md\n' >"$claude_file"
    echo "Created with AGENTS.md import: ${claude_file}"
  elif grep -Eq '(^|[[:space:]])@(\./)?AGENTS\.md([[:space:]]|$)' "$claude_file"; then
    echo "AGENTS.md import already present: ${claude_file}"
  else
    if [ -s "$claude_file" ]; then
      printf '\n@AGENTS.md\n' >>"$claude_file"
    else
      printf '@AGENTS.md\n' >>"$claude_file"
    fi
    echo "Added AGENTS.md import: ${claude_file}"
  fi
}

cmd_agent() {
  [ $# -ge 1 ] || { usage_agent; exit 1; }
  local subcmd="$1"
  shift
  case "$subcmd" in
    init) cmd_agent_init "$@" ;;
    -h|--help|help) usage_agent ;;
    *) die "unknown agent subcommand: ${subcmd}. Use init" ;;
  esac
}

cmd_init() {
  local patch_agent=false
  local local_mode=false
  local repo_arg="."
  while [ $# -gt 0 ]; do
    case "$1" in
      --patch-agent-files) patch_agent=true ;;
      --local) local_mode=true ;;
      --repo) shift; repo_arg="${1:?--repo requires a path}" ;;
      *) die "unknown init option: $1" ;;
    esac
    shift
  done

  local repo_root
  if [ "$local_mode" = true ]; then
    ensure_git_path "$repo_arg"
  fi
  repo_root="$(project_root "$repo_arg")"

  copy_if_missing "${TEMPLATE_DIR}/.agent-harness/planner.md" "${repo_root}/.agent-harness/planner.md"
  copy_if_missing "${TEMPLATE_DIR}/.agent-harness/executor.md" "${repo_root}/.agent-harness/executor.md"
  copy_if_missing "${TEMPLATE_DIR}/.agent-harness/finisher.md" "${repo_root}/.agent-harness/finisher.md"
  copy_if_missing "${TEMPLATE_DIR}/.agent-harness/role-models.yml" "${repo_root}/.agent-harness/role-models.yml"
  copy_if_missing "${TEMPLATE_DIR}/.agent-harness/task-states.md" "${repo_root}/.agent-harness/task-states.md"
  copy_if_missing "${TEMPLATE_DIR}/.agent-harness/llm-anti-patterns.md" "${repo_root}/.agent-harness/llm-anti-patterns.md"
  copy_if_missing "${TEMPLATE_DIR}/.claude/commands/planwt.md" "${repo_root}/.claude/commands/planwt.md"
  copy_if_missing "${TEMPLATE_DIR}/.claude/commands/finishwt.md" "${repo_root}/.claude/commands/finishwt.md"
  copy_if_missing "${TEMPLATE_DIR}/.claude/commands/statuswt.md" "${repo_root}/.claude/commands/statuswt.md"
  copy_if_missing "${TEMPLATE_DIR}/.agents/skills/planwt/SKILL.md" "${repo_root}/.agents/skills/planwt/SKILL.md"
  copy_if_missing "${TEMPLATE_DIR}/.agents/skills/finishwt/SKILL.md" "${repo_root}/.agents/skills/finishwt/SKILL.md"
  copy_if_missing "${TEMPLATE_DIR}/.agents/skills/statuswt/SKILL.md" "${repo_root}/.agents/skills/statuswt/SKILL.md"
  
  for preset in balanced anthropic openai google; do
    copy_if_missing "${TEMPLATE_DIR}/.agent-harness/presets/preset-${preset}.yml" "${repo_root}/.agent-harness/presets/preset-${preset}.yml"
  done

  if [ "$local_mode" = true ]; then
    local exclude_file
    exclude_file="$(git_info_exclude_path "$repo_root")"
    [ -n "$exclude_file" ] || die "failed to resolve .git/info/exclude for ${repo_root}"
    mkdir -p "$(dirname "$exclude_file")"
    [ -f "$exclude_file" ] || : >"$exclude_file"
    if ! grep -qxF '# wtcraft local scaffold' "$exclude_file"; then
      printf '\n# wtcraft local scaffold\n' >>"$exclude_file"
    fi
    local local_rule
    for local_rule in \
      '/.worktree-task.md' \
      '/.worktree-state.json' \
      '/.agent-harness/' \
      '/.claude/commands/' \
      '/.agents/skills/' \
      '/AGENTS.md' \
      '/CLAUDE.md'
    do
      if ! grep -qxF "$local_rule" "$exclude_file"; then
        printf '%s\n' "$local_rule" >>"$exclude_file"
      fi
    done
  else
    # Ensure local task specification/state files are ignored in the user's repo.
    local gitignore="${repo_root}/.gitignore"
    local task_rule
    for task_rule in '/.worktree-task.md' '/.worktree-state.json'; do
      if ! grep -qxF "$task_rule" "$gitignore" 2>/dev/null; then
        if [ ! -f "$gitignore" ] ||
           { ! grep -qxF '# wtcraft local task files' "$gitignore" 2>/dev/null &&
             ! grep -qxF '# wtcraft local task state.' "$gitignore" 2>/dev/null &&
             ! grep -qxF '# wtcraft local task state' "$gitignore" 2>/dev/null; }; then
          printf '\n# wtcraft local task files\n' >>"$gitignore"
        fi
        printf '%s\n' "$task_rule" >> "$gitignore"
      fi
    done
  fi

  cat <<'EOF'
 Initialized wtcraft harness files (existing files were left untouched):
   .agent-harness/planner.md
   .agent-harness/executor.md
   .agent-harness/finisher.md
   .agent-harness/role-models.yml
   .agent-harness/task-states.md
   .agent-harness/llm-anti-patterns.md
   .agent-harness/presets/
   .claude/commands/planwt.md
   .claude/commands/finishwt.md
   .claude/commands/statuswt.md
   .agents/skills/planwt/SKILL.md
   .agents/skills/finishwt/SKILL.md
   .agents/skills/statuswt/SKILL.md
EOF

  if [ "$patch_agent" = true ]; then
    echo
    echo "Applying optional routing stubs to agent files..."
    patch_agent_files "$repo_root"
  else
    echo
    echo "Agent files were not modified (default behavior)."
    echo "Use: wtcraft init --patch-agent-files"
  fi

  if [ "$local_mode" = true ]; then
    echo
    echo "Local mode enabled: wtcraft scaffold is ignored via .git/info/exclude in this clone only."
  fi

  echo
  echo "Initialized wtcraft harness using wtcraft $(read_cli_version)"
  if [ -f "${repo_root}/.worktree-task.template.md" ]; then
    echo
    echo "Legacy scaffold detected: .worktree-task.template.md"
    echo "Run: wtcraft migrate"
  fi
}

# Files init-ci vendors into a target repository. The adapter has to live in
# the repository, not be installed at check time: the workflow runs under
# pull_request_target from the trusted base checkout, where adding an install
# step would both widen the privileged job and drop the review requirement the
# threat model places on the adapter implementation.
ci_vendored_files() {
  cat <<'LIST'
.github/workflows/wtcraft-trusted-change.yml
.wtcraft/policy_evaluator.py
.wtcraft/policy_git_adapter.py
LIST
}

cmd_init_ci() {
  local repo_arg="."
  local force=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) shift; repo_arg="${1:?--repo requires a path}" ;;
      --force) force=true ;;
      *) die "unknown init-ci option: $1" ;;
    esac
    shift
  done

  ensure_git_path "$repo_arg"
  local repo_root
  repo_root="$(project_root "$repo_arg")"

  local installed="" drifted="" unchanged=""
  local rel src dst
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    src="${TEMPLATE_DIR}/${rel}"
    dst="${repo_root}/${rel}"
    [ -f "$src" ] || die "missing template: ${src}"
    if [ ! -e "$dst" ]; then
      mkdir -p "$(dirname "$dst")"
      cp "$src" "$dst"
      installed="${installed}   ${rel}"$'\n'
    elif cmp -s "$src" "$dst"; then
      unchanged="${unchanged}   ${rel}"$'\n'
    elif [ "$force" = true ]; then
      cp "$src" "$dst"
      installed="${installed}   ${rel} (replaced)"$'\n'
    else
      drifted="${drifted}   ${rel}"$'\n'
    fi
  done <<EOF
$(ci_vendored_files)
EOF

  if [ -n "$installed" ]; then
    echo "Installed:"
    printf '%s' "$installed"
  fi
  if [ -n "$unchanged" ]; then
    echo "Already up to date:"
    printf '%s' "$unchanged"
  fi
  if [ -n "$drifted" ]; then
    echo
    echo "Differs from this wtcraft version and was NOT changed:"
    printf '%s' "$drifted"
    echo
    echo "A vendored copy does not receive wtcraft's fixes. If you did not edit"
    echo "these deliberately, refresh them: wtcraft init-ci --force"
  fi

  cat <<'EOF'

This installs a check. It does not enforce anything yet.

Remaining steps are repository administration and cannot be scripted:
  1. Create refs/heads/wtcraft-policy and deny executors direct write access.
  2. Require review for .wtcraft/policies/** (CODEOWNERS or equivalent).
  3. Protect the workflow and the vendored adapter from ordinary task changes.
  4. Pin actions/checkout and actions/upload-artifact by commit SHA.
  5. Open an unauthorized PR and confirm the job fails; then an authorized one
     and read its evidence JSON. Cover a rename out of an off-limits path and
     a PR whose base advanced after approval.
  6. Only then make "wtcraft / trusted-change-authorization" a required check.

The verdict is an authorization gate only. The reviewed verification plan is
reported with "status": "not_executed" and is never run by this job, so a pass
does not mean the tests passed. Ordinary CI still owns test, lint, and build.

Setup guide: docs/security/github-actions-integration.md
EOF
}

cmd_patch() {
  cmd_init --patch-agent-files "$@"
}

cmd_unpatch() {
  local repo_arg="."
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) shift; repo_arg="${1:?--repo requires a path}" ;;
      *) die "unknown unpatch option: $1" ;;
    esac
    shift
  done
  local repo_root
  repo_root="$(project_root "$repo_arg")"
  echo "Removing wtcraft routing stubs from agent files..."
  unpatch_agent_files "$repo_root"
}

cmd_lang() {
  [ $# -ge 1 ] || { usage_lang; exit 1; }
  local subcmd="$1"; shift
  local repo_arg="."
  local remaining=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) shift; repo_arg="${1:?--repo requires a path}" ;;
      *) remaining+=("$1") ;;
    esac
    shift
  done
  local repo_root
  repo_root="$(project_root "$repo_arg")"
  local claude_file="${repo_root}/CLAUDE.md"
  local agents_file="${repo_root}/AGENTS.md"
  set -- ${remaining[@]+"${remaining[@]}"}

  case "$subcmd" in
    install)
      local lang="en"
      while [ $# -gt 0 ]; do
        case "$1" in
          --lang) shift; lang="${1:?--lang requires a value}"; shift ;;
          *) die "unknown lang install option: $1" ;;
        esac
      done

      local lang_block
      case "$lang" in
        en)
          lang_block="$(cat <<'EOF'
<!-- wtcraft:lang:start -->
## Language Enforcement
CRITICAL: Output YOUR ENTIRE RESPONSE in **English** only.
<!-- wtcraft:lang:end -->
EOF
)"
          ;;
        zh-CN)
          lang_block="$(cat <<'EOF'
<!-- wtcraft:lang:start -->
## Language Enforcement
CRITICAL: Output YOUR ENTIRE RESPONSE in **Simplified Chinese (简体中文)** or English only.
<!-- wtcraft:lang:end -->
EOF
)"
          ;;
        *)
          die "unsupported language code: ${lang}. Supported: en, zh-CN"
          ;;
      esac

      # Patch only the agent files that already exist; never conjure one.
      # CLAUDE.md and AGENTS.md are created by `wtcraft patch`.
      if [ ! -f "$claude_file" ] && [ ! -f "$agents_file" ]; then
        die "no CLAUDE.md or AGENTS.md in ${repo_root}. Run 'wtcraft agent init' first, then re-run lang install."
      fi
      if [ -f "$claude_file" ]; then
        append_managed_block_if_missing "$claude_file" "$lang_block" "<!-- wtcraft:lang:start -->"
      fi
      if [ -f "$agents_file" ]; then
        append_managed_block_if_missing "$agents_file" "$lang_block" "<!-- wtcraft:lang:start -->"
      fi
      ;;
    remove)
      [ $# -eq 0 ] || die "lang remove takes no arguments"
      remove_managed_block "$claude_file" \
        "<!-- wtcraft:lang:start -->" "<!-- wtcraft:lang:end -->"
      remove_managed_block "$agents_file" \
        "<!-- wtcraft:lang:start -->" "<!-- wtcraft:lang:end -->"
      ;;
    *)
      die "unknown lang subcommand: ${subcmd}. Use install or remove"
      ;;
  esac
}

extract_frontmatter() {
  local file="$1"
  local key="$2"
  awk -v key="$key" '
    BEGIN { in_fm=0 }
    /^---$/ {
      if (in_fm==0) { in_fm=1; next }
      else { in_fm=0; exit }
    }
    in_fm==1 {
      if ($0 ~ "^" key ":") {
        sub("^" key ":[[:space:]]*", "", $0)
        print $0
        exit
      }
    }
  ' "$file"
}

# set_frontmatter <file> <key> <value>
#
# Update key in the frontmatter block, or insert it before the closing ---
# when absent. Only the first frontmatter block is touched.
set_frontmatter() {
  local file="$1"
  local key="$2"
  local value="$3"
  local tmp="${file}.tmp"
  awk -v key="$key" -v value="$value" '
    BEGIN { in_fm=0; fm_done=0; written=0 }
    /^---$/ {
      if (fm_done==0 && in_fm==0) { in_fm=1; print; next }
      if (in_fm==1) {
        if (written==0) { print key ": " value; written=1 }
        in_fm=0; fm_done=1; print; next
      }
      print; next
    }
    in_fm==1 && written==0 && $0 ~ "^" key ":" { print key ": " value; written=1; next }
    { print }
  ' "$file" > "$tmp" && mv "$tmp" "$file"
}

# list_worktrees <repo_root>
#
# Emit NUL-delimited triples: worktree-path, branch, flags. Git's `-z` output
# keeps paths containing newlines intact; this parser must remain NUL-based
# end-to-end.
list_worktrees() {
  local repo_root="$1"
  local field wt="" branch="" flags=""
  while IFS= read -r -d '' field; do
    if [ -z "$field" ]; then
      if [ -n "$wt" ]; then
        printf '%s\0%s\0%s\0' "$wt" "$branch" "$flags"
      fi
      wt=""
      branch=""
      flags=""
      continue
    fi
    case "$field" in
      "worktree "*) wt="${field#worktree }" ;;
      "branch refs/heads/"*) branch="${field#branch refs/heads/}" ;;
      prunable*) flags="${flags}prunable," ;;
      locked*) flags="${flags}locked," ;;
    esac
  done < <(git -C "$repo_root" worktree list --porcelain -z)
  if [ -n "$wt" ]; then
    printf '%s\0%s\0%s\0' "$wt" "$branch" "$flags"
  fi
}

json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  local code octal char escaped
  code=1
  while [ "$code" -le 31 ]; do
    printf -v octal '%03o' "$code"
    printf -v char '%b' "\\${octal}"
    printf -v escaped '\\u%04x' "$code"
    s="${s//$char/$escaped}"
    code=$((code + 1))
  done
  printf '%s' "$s"
}

# json_field <value> — quoted JSON string, or null when empty
json_field() {
  if [ -z "$1" ]; then
    printf 'null'
  else
    printf '"%s"' "$(json_escape "$1")"
  fi
}

json_number_field() {
  case "$1" in
    ""|*[!0-9]*) printf 'null' ;;
    *) printf '%s' "$1" ;;
  esac
}

json_error_object() {
  local command="$1"
  local code="$2"
  local message="$3"
  printf '{"protocol_version":1,"command":"%s","ok":false,"error":{"code":%s,"message":"%s"}}\n' \
    "$(json_escape "$command")" \
    "$code" \
    "$(json_escape "$message")"
}

machine_error() {
  local as_json="$1"
  local command="$2"
  local message="$3"
  if [ "$as_json" = true ]; then
    json_error_object "$command" 1 "$message"
    exit 1
  fi
  die "$message"
}

json_string_array() {
  local out="[" first=1 item
  for item in "$@"; do
    [ -z "$item" ] && continue
    if [ "$first" -eq 1 ]; then
      out="${out}$(json_field "$item")"
      first=0
    else
      out="${out},$(json_field "$item")"
    fi
  done
  printf '%s]' "$out"
}

json_object_array() {
  local out="[" first=1 item
  for item in "$@"; do
    [ -z "$item" ] && continue
    if [ "$first" -eq 1 ]; then
      out="${out}${item}"
      first=0
    else
      out="${out},${item}"
    fi
  done
  printf '%s]' "$out"
}

utc_now() {
  date -u +"%Y-%m-%dT%H:%M:%SZ"
}

task_state_path() {
  local task_file="$1"
  local declared
  declared="$(extract_frontmatter "$task_file" "state_file")"
  if [ -n "$declared" ] && [ "$declared" != ".worktree-state.json" ]; then
    return 1
  fi
  printf '%s/.worktree-state.json' "$(dirname "$task_file")"
}

# Read one scalar from the flat, wtcraft-owned state document. State v1 keeps
# these coordination fields flat so the Bash reference implementation needs no
# jq/Python runtime dependency. Writers still emit valid JSON atomically.
state_get() {
  local file="$1"
  local key="$2"
  [ -f "$file" ] || return 0
  awk -v key="$key" '
    $0 ~ "^[[:space:]]*\\\"" key "\\\"[[:space:]]*:" {
      value=$0
      sub("^[[:space:]]*\\\"" key "\\\"[[:space:]]*:[[:space:]]*", "", value)
      sub(/,[[:space:]]*$/, "", value)
      if (value == "null") exit
      if (substr(value, 1, 1) == "\"" && substr(value, length(value), 1) == "\"") {
        value=substr(value, 2, length(value)-2)
      }
      out=""
      for (i=1; i<=length(value); i++) {
        c=substr(value, i, 1)
        if (c == "\\" && i < length(value)) {
          n=substr(value, ++i, 1)
          if (n == "\"" || n == "\\" || n == "/") out=out n
          else out=out "\\" n
        } else out=out c
      }
      print out
      exit
    }
  ' "$file"
}

state_set_json() {
  local file="$1"
  local key="$2"
  local value="$3"
  local tmp
  tmp="$(mktemp "${file}.tmp.XXXXXX")"
  if ! WTCRAFT_STATE_JSON_VALUE="$value" awk -v key="$key" '
    BEGIN { written=0; value=ENVIRON["WTCRAFT_STATE_JSON_VALUE"] }
    $0 ~ "^[[:space:]]*\\\"" key "\\\"[[:space:]]*:" {
      comma = ($0 ~ /,[[:space:]]*$/) ? "," : ""
      print "  \"" key "\": " value comma
      written=1
      next
    }
    { print }
    END { if (written==0) exit 2 }
  ' "$file" >"$tmp"; then
    rm -f "$tmp"
    die "missing state field '${key}' in ${file}"
  fi
  mv "$tmp" "$file"
}

state_set_string() {
  local file="$1"
  local key="$2"
  local value="$3"
  state_set_json "$file" "$key" "$(json_field "$value")"
}

state_set_number() {
  local file="$1"
  local key="$2"
  local value="$3"
  state_set_json "$file" "$key" "$value"
}

STATE_V1_FIELDS="schema_version task_id stage role agent status attempt handoff_from handoff_to check_result checked check_snapshot verify_result verified verify_snapshot created_at updated_at"

# state_valid <file>
#
# Returns 0 when the sidecar uses the v1 layout the Bash reference reads and
# writes: `{` and `}` on their own lines, one scalar field per line, and every
# v1 field present. JSON in any other layout (a compact single line, say) is
# reported as invalid instead of being read as empty values.
state_valid() {
  local file="$1"
  [ -f "$file" ] || return 1
  awk -v fields="$STATE_V1_FIELDS" '
    function field_key(line,    rest, key, c, i) {
      trailing_comma = 0
      rest = line
      sub(/^[ \t]*/, "", rest)
      if (substr(rest, 1, 1) != "\"") return ""
      rest = substr(rest, 2)
      i = index(rest, "\"")
      if (i < 2) return ""
      key = substr(rest, 1, i - 1)
      if (key !~ /^[A-Za-z0-9_]+$/) return ""
      rest = substr(rest, i + 1)
      sub(/^[ \t]*/, "", rest)
      if (substr(rest, 1, 1) != ":") return ""
      rest = substr(rest, 2)
      sub(/^[ \t]*/, "", rest)
      if (substr(rest, 1, 1) == "\"") {
        for (i = 2; i <= length(rest); i++) {
          c = substr(rest, i, 1)
          if (c == "\\") { i++; continue }
          if (c == "\"") break
        }
        if (i > length(rest)) return ""
        rest = substr(rest, i + 1)
      } else if (match(rest, /^(null|true|false|-?[0-9]+)/)) {
        rest = substr(rest, RLENGTH + 1)
      } else {
        return ""
      }
      sub(/[ \t]*$/, "", rest)
      if (rest == ",") trailing_comma = 1
      else if (rest != "") return ""
      return key
    }
    { lines++; body[lines] = $0 }
    END {
      if (lines < 2 || body[1] !~ /^[ \t]*[{][ \t]*$/ || body[lines] !~ /^[ \t]*[}][ \t]*$/) exit 1
      for (n = 2; n < lines; n++) {
        key = field_key(body[n])
        if (key == "") exit 1
        if (n < lines - 1 && !trailing_comma) exit 1
        if (n == lines - 1 && trailing_comma) exit 1
        seen[key] = 1
      }
      count = split(fields, required, " ")
      for (n = 1; n <= count; n++) if (!(required[n] in seen)) exit 1
    }
  ' "$file"
}

require_valid_state() {
  local as_json="$1"
  local command="$2"
  local state_file="$3"
  state_valid "$state_file" || machine_error "$as_json" "$command" \
    "invalid state file: ${state_file} (expected the v1 layout: one field per line, every v1 field present; see docs/protocol/task-state-sidecar-v1.md)"
}

# A multi-field update edits a private copy of the sidecar and publishes it
# with one rename. The copy, and any per-field temporary file beside it, is
# removed if the command exits before publishing.
STATE_UPDATE_FILE=""

cleanup_state_update() {
  if [ -n "$STATE_UPDATE_FILE" ]; then
    rm -f "$STATE_UPDATE_FILE" "$STATE_UPDATE_FILE".tmp.*
    STATE_UPDATE_FILE=""
  fi
}

state_begin_update() {
  local state_file="$1"
  trap cleanup_state_update EXIT
  trap 'cleanup_state_update; exit 130' INT
  trap 'cleanup_state_update; exit 143' TERM
  STATE_UPDATE_FILE="$(mktemp "${state_file}.update.XXXXXX")"
  if ! cp "$state_file" "$STATE_UPDATE_FILE"; then
    cleanup_state_update
    die "failed to copy state file: ${state_file}"
  fi
}

state_commit_update() {
  local state_file="$1"
  mv "$STATE_UPDATE_FILE" "$state_file"
  STATE_UPDATE_FILE=""
  trap - EXIT INT TERM
}

write_task_state() {
  local state_file="$1"
  local task_id="$2"
  local stage="$3"
  local role="$4"
  local agent="$5"
  local status_legacy="$6"
  local verify_result="$7"
  local verified="$8"
  local now tmp
  now="$(utc_now)"
  tmp="$(mktemp "${state_file}.tmp.XXXXXX")"
  {
    printf '{\n'
    printf '  "schema_version": 1,\n'
    printf '  "task_id": %s,\n' "$(json_field "$task_id")"
    printf '  "stage": %s,\n' "$(json_field "${stage:-planned}")"
    printf '  "role": %s,\n' "$(json_field "${role:-executor}")"
    printf '  "agent": %s,\n' "$(json_field "$agent")"
    printf '  "status": %s,\n' "$(json_field "${status_legacy:-ready}")"
    printf '  "attempt": 0,\n'
    printf '  "handoff_from": null,\n'
    printf '  "handoff_to": null,\n'
    printf '  "check_result": null,\n'
    printf '  "checked": null,\n'
    printf '  "check_snapshot": null,\n'
    printf '  "verify_result": %s,\n' "$(json_field "$verify_result")"
    printf '  "verified": %s,\n' "$(json_field "$verified")"
    printf '  "verify_snapshot": null,\n'
    printf '  "created_at": %s,\n' "$(json_field "$now")"
    printf '  "updated_at": %s\n' "$(json_field "$now")"
    printf '}\n'
  } >"$tmp" && mv "$tmp" "$state_file"
}

ensure_task_state() {
  local task_file="$1"
  local state_file="$2"
  [ -f "$state_file" ] && return 0
  local task_id stage role agent status_legacy verify_result verified
  task_id="$(extract_frontmatter "$task_file" "task_id")"
  [ -n "$task_id" ] || task_id="$(extract_frontmatter "$task_file" "branch")"
  [ -n "$task_id" ] || task_id="$(basename "$(dirname "$task_file")")"
  stage="$(extract_frontmatter "$task_file" "stage")"
  role="$(extract_frontmatter "$task_file" "role")"
  agent="$(extract_frontmatter "$task_file" "agent")"
  status_legacy="$(extract_frontmatter "$task_file" "status")"
  verify_result="$(extract_frontmatter "$task_file" "verify_result")"
  verified="$(extract_frontmatter "$task_file" "verified")"
  write_task_state "$state_file" "$task_id" "$stage" "$role" "$agent" \
    "$status_legacy" "$verify_result" "$verified"
}

remove_task_state_frontmatter() {
  local file="$1"
  local tmp="${file}.tmp"
  awk '
    BEGIN { in_fm=0; fm_done=0 }
    /^---$/ {
      if (fm_done==0 && in_fm==0) { in_fm=1; print; next }
      if (in_fm==1) { in_fm=0; fm_done=1; print; next }
    }
    in_fm==1 && $0 ~ /^(agent|stage|role|status|verify_result|verified):/ { next }
    { print }
  ' "$file" >"$tmp" && mv "$tmp" "$file"
}

ensure_task_state_notice() {
  local file="$1"
  grep -qF '<!-- wtcraft:state-sidecar -->' "$file" && return 0
  local tmp="${file}.tmp"
  awk '
    BEGIN { fm_markers=0; inserted=0 }
    {
      print
      if ($0 == "---") fm_markers++
      if (fm_markers == 2 && inserted == 0) {
        print ""
        print "<!-- wtcraft:state-sidecar -->"
        print "> This file is the stable task specification. Mutable lifecycle and check/"
        print "> verification results live in `.worktree-state.json`; update them through"
        print "> `wtcraft state`, `wtcraft check`, and `wtcraft verify`, not in this Markdown."
        inserted=1
      }
    }
  ' "$file" >"$tmp" && mv "$tmp" "$file"
}

# legacy_lifecycle_fields <task_file>
#
# Print the lifecycle/result keys still set in the task frontmatter, space
# separated. Once a sidecar exists these keys are ignored, so harness guidance
# that still writes them would otherwise change nothing without any notice.
legacy_lifecycle_fields() {
  awk '
    BEGIN { in_fm=0; out="" }
    /^---$/ { if (in_fm==0) { in_fm=1; next } else exit }
    in_fm==1 && match($0, /^(agent|stage|role|status|verify_result|verified):/) {
      out = out (out == "" ? "" : " ") substr($0, 1, RLENGTH - 1)
    }
    END { print out }
  ' "$1"
}

warn_ignored_legacy_fields() {
  local task_file="$1"
  local fields
  fields="$(legacy_lifecycle_fields "$task_file")"
  [ -n "$fields" ] || return 0
  echo "warning: ${task_file} frontmatter sets ${fields}; .worktree-state.json overrides these fields. Remove them and record lifecycle with 'wtcraft state'." >&2
}

# task_spec_digest <task_file>
#
# Digest of the specification inputs that check and verify consume: the Scope
# and Off-limits items and the Verification commands. Checkbox state and other
# Markdown are not inputs, so ticking a step or editing Context leaves the
# digest unchanged.
task_spec_digest() {
  local task_file="$1"
  {
    printf 'SCOPE\0'
    collect_section_items "$task_file" "Scope"
    printf '\0OFF-LIMITS\0'
    collect_section_items "$task_file" "Off-limits"
    printf '\0VERIFICATION\0'
    collect_verification_commands "$task_file"
  } | git hash-object --stdin
}

# Bind check/verify evidence to what they read and judge: the specification
# inputs, HEAD, uncommitted tracked edits, and untracked contents. The local
# task files are coordination metadata, not deliverables.
worktree_snapshot() {
  local wt_path="$1"
  local spec_digest
  spec_digest="$(task_spec_digest "${wt_path}/.worktree-task.md")"
  (
    cd "$wt_path"
    {
      printf 'HEAD\0'
      git rev-parse HEAD
      printf '\0TASK-SPEC\0%s\0' "$spec_digest"
      printf 'TRACKED-DIFF\0'
      git diff --binary HEAD
      printf '\0UNTRACKED\0'
      while IFS= read -r -d '' file; do
        case "$file" in
          .worktree-task.md|.worktree-state.json|.worktree-state.json.*) continue ;;
        esac
        printf '%s\0' "$file"
        if [ -L "${file%/}" ]; then
          printf 'symlink\0'
          readlink "${file%/}"
        elif [ -d "$file" ]; then
          # Git lists an untracked nested repository as a single directory.
          printf 'repository\0'
          git -C "$file" rev-parse -q --verify HEAD || true
        else
          git hash-object "$file"
        fi
        printf '\0'
      done < <(git ls-files -z --others --exclude-standard)
    } | git hash-object --stdin
  )
}

cmd_status() {
  local as_json=false
  local repo_arg="."
  while [ $# -gt 0 ]; do
    case "$1" in
      --json)
        as_json=true
        shift
        ;;
      --repo)
        [ $# -ge 2 ] || machine_error "$as_json" "status" "--repo requires a path"
        repo_arg="$2"
        shift 2
        ;;
      --*)
        machine_error "$as_json" "status" "unknown status option: $1"
        ;;
      *)
        break
        ;;
    esac
  done
  [ $# -eq 0 ] || machine_error "$as_json" "status" "status takes no positional arguments"
  local repo_root
  repo_root="$(primary_worktree_root "$repo_arg")"
  if [ -z "$repo_root" ]; then
    if [ "$as_json" = true ]; then
      machine_error "$as_json" "status" "not inside a git repository: ${repo_arg}"
    fi
    die "not inside a git repository: ${repo_arg}"
  fi

  if [ "$as_json" = false ]; then
    printf "%-45s %-13s %-10s %-8s %-8s %-10s\n" "Worktree / Task" "Stage" "Role" "Agent" "Priority" "Verified"
    printf "%-45s %-13s %-10s %-8s %-8s %-10s\n" "---------------" "-----" "----" "-----" "--------" "--------"
  fi

  local found=0 wt branch flags
  local json_entries=()
  while IFS= read -r -d '' wt && IFS= read -r -d '' branch && IFS= read -r -d '' flags; do
    [ -z "$wt" ] && continue
    # Skip the primary worktree (repo root), keep only linked worktrees.
    [ "$wt" = "$repo_root" ] && continue
    found=1
    local rel="$wt"
    case "$wt" in
      "$repo_root"/*) rel="${wt#"${repo_root}"/}" ;;
    esac

    local zombie=false locked=false contracted=false
    [[ "$flags" == *prunable,* ]] && zombie=true
    [[ "$flags" == *locked,* ]] && locked=true

    local task="${wt}/.worktree-task.md"
    local state="${wt}/.worktree-state.json"
    local stage="" status_legacy="" role="" agent="" priority="" created="" base=""
    local attempt="" handoff_from="" handoff_to="" check_result="" checked=""
    local verify_result="" verified="" created_at="" updated_at=""
    local state_present=false state_valid_flag=null legacy_frontmatter_ignored=false
    local ready=false evidence_stale=false
    if [ "$zombie" = false ] && [ -f "$task" ]; then
      contracted=true
      priority="$(extract_frontmatter "$task" "priority")"
      created="$(extract_frontmatter "$task" "created")"
      base="$(extract_frontmatter "$task" "base")"
      if [ -f "$state" ]; then
        state_present=true
        if state_valid "$state"; then
          state_valid_flag=true
        else
          state_valid_flag=false
          [ "$as_json" = true ] ||
            echo "warning: ${state} does not use the v1 state layout; its lifecycle and results are not shown" >&2
        fi
      fi
      if [ "$state_present" = true ] && [ -n "$(legacy_lifecycle_fields "$task")" ]; then
        legacy_frontmatter_ignored=true
        [ "$as_json" = true ] || warn_ignored_legacy_fields "$task"
      fi
      if [ "$state_valid_flag" = true ]; then
        stage="$(state_get "$state" "stage")"
        status_legacy="$(state_get "$state" "status")"
        role="$(state_get "$state" "role")"
        agent="$(state_get "$state" "agent")"
        attempt="$(state_get "$state" "attempt")"
        handoff_from="$(state_get "$state" "handoff_from")"
        handoff_to="$(state_get "$state" "handoff_to")"
        check_result="$(state_get "$state" "check_result")"
        checked="$(state_get "$state" "checked")"
        verify_result="$(state_get "$state" "verify_result")"
        verified="$(state_get "$state" "verified")"
        created_at="$(state_get "$state" "created_at")"
        updated_at="$(state_get "$state" "updated_at")"

        local check_snapshot verify_snapshot current_snapshot
        check_snapshot="$(state_get "$state" "check_snapshot")"
        verify_snapshot="$(state_get "$state" "verify_snapshot")"
        if { [ -n "$check_snapshot" ] || [ -n "$verify_snapshot" ]; }; then
          current_snapshot="$(worktree_snapshot "$wt")"
          if { [ -n "$check_snapshot" ] && [ "$check_snapshot" != "$current_snapshot" ]; } ||
             { [ -n "$verify_snapshot" ] && [ "$verify_snapshot" != "$current_snapshot" ]; }; then
            evidence_stale=true
          fi
          if [ "$check_result" = "pass" ] && [ "$verify_result" = "pass" ] &&
             [ "$check_snapshot" = "$current_snapshot" ] &&
             [ "$verify_snapshot" = "$current_snapshot" ]; then
            ready=true
          fi
        fi
      elif [ "$state_present" = false ]; then
        # Read-only compatibility for contracts created before state sidecars.
        stage="$(extract_frontmatter "$task" "stage")"
        status_legacy="$(extract_frontmatter "$task" "status")"
        role="$(extract_frontmatter "$task" "role")"
        agent="$(extract_frontmatter "$task" "agent")"
        verify_result="$(extract_frontmatter "$task" "verify_result")"
        verified="$(extract_frontmatter "$task" "verified")"
      fi
      [ -n "$stage" ] || stage="$status_legacy"
    fi

    if [ "$as_json" = true ]; then
      local entry
      entry="{\"repo_root\":$(json_field "$repo_root"),\"worktree\":$(json_field "$wt"),\"branch\":$(json_field "$branch"),\"zombie\":${zombie},\"locked\":${locked},\"contracted\":${contracted}"
      if [ "$contracted" = true ]; then
        entry="${entry},\"task_file\":$(json_field "$task"),\"state_file\":$(json_field "$state"),\"state_present\":${state_present},\"state_valid\":${state_valid_flag},\"legacy_frontmatter_ignored\":${legacy_frontmatter_ignored},\"stage\":$(json_field "$stage"),\"role\":$(json_field "$role"),\"agent\":$(json_field "$agent"),\"status\":$(json_field "$status_legacy"),\"attempt\":$(json_number_field "$attempt"),\"handoff_from\":$(json_field "$handoff_from"),\"handoff_to\":$(json_field "$handoff_to"),\"check_result\":$(json_field "$check_result"),\"checked\":$(json_field "$checked"),\"priority\":$(json_field "$priority"),\"created\":$(json_field "$created"),\"base\":$(json_field "$base"),\"verify_result\":$(json_field "$verify_result"),\"verified\":$(json_field "$verified"),\"created_at\":$(json_field "$created_at"),\"updated_at\":$(json_field "$updated_at"),\"ready\":${ready},\"evidence_stale\":${evidence_stale}"
      fi
      json_entries+=("${entry}}")
      continue
    fi

    if [ "$zombie" = true ]; then
      printf "%-45s %-13s %-10s %-8s %-8s %-10s\n" "$rel" "zombie" "-" "-" "-" "-"
    elif [ "$contracted" = false ]; then
      printf "%-45s %-13s %-10s %-8s %-8s %-10s\n" "$rel" "uncontracted" "-" "-" "-" "-"
    else
      printf "%-45s %-13s %-10s %-8s %-8s %-10s\n" \
        "${rel}/.worktree-task.md" "${stage:-unknown}" "${role:--}" \
        "${agent:-unknown}" "${priority:-unknown}" "${verify_result:--}"
    fi
  done < <(list_worktrees "$repo_root")

  if [ "$as_json" = true ]; then
    json_object_array "${json_entries[@]:-}"
    printf '\n'
    return 0
  fi

  if [ "$found" -eq 0 ]; then
    echo "No linked worktrees found."
  fi
}

cmd_state() {
  local as_json=false
  local repo_arg="."
  local target="" stage="" role="" agent="" attempt="" handoff_from="" handoff_to=""
  local handoff_from_set=false handoff_to_set=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) as_json=true; shift ;;
      --repo) [ $# -ge 2 ] || machine_error "$as_json" "state" "--repo requires a path"; repo_arg="$2"; shift 2 ;;
      --stage) [ $# -ge 2 ] || machine_error "$as_json" "state" "--stage requires a value"; stage="$2"; shift 2 ;;
      --role) [ $# -ge 2 ] || machine_error "$as_json" "state" "--role requires a value"; role="$2"; shift 2 ;;
      --agent) [ $# -ge 2 ] || machine_error "$as_json" "state" "--agent requires a value"; agent="$2"; shift 2 ;;
      --attempt) [ $# -ge 2 ] || machine_error "$as_json" "state" "--attempt requires a value"; attempt="$2"; shift 2 ;;
      --handoff-from) [ $# -ge 2 ] || machine_error "$as_json" "state" "--handoff-from requires a value"; handoff_from="$2"; handoff_from_set=true; shift 2 ;;
      --handoff-to) [ $# -ge 2 ] || machine_error "$as_json" "state" "--handoff-to requires a value"; handoff_to="$2"; handoff_to_set=true; shift 2 ;;
      --*) machine_error "$as_json" "state" "unknown state option: $1" ;;
      *)
        [ -z "$target" ] || machine_error "$as_json" "state" "state expects exactly one worktree target"
        target="$1"
        shift
        ;;
    esac
  done
  [ -n "$target" ] || machine_error "$as_json" "state" "state requires a worktree target"
  if [ -z "$stage" ] && [ -z "$role" ] && [ -z "$agent" ] && [ -z "$attempt" ] &&
     [ "$handoff_from_set" = false ] && [ "$handoff_to_set" = false ]; then
    machine_error "$as_json" "state" "state requires at least one update"
  fi

  case "$stage" in
    ""|planned|executing|verifying|replan|approved|finishing|done) ;;
    *) machine_error "$as_json" "state" "unsupported stage: ${stage}" ;;
  esac
  case "$role" in
    ""|planner|executor|verifier|finisher|none) ;;
    *) machine_error "$as_json" "state" "unsupported role: ${role}" ;;
  esac
  case "$attempt" in
    "") ;;
    *[!0-9]*) machine_error "$as_json" "state" "attempt must be a non-negative integer" ;;
  esac
  local name
  for name in "$agent" "$handoff_from" "$handoff_to"; do
    case "$name" in
      *[[:cntrl:]]*) machine_error "$as_json" "state" "agent and handoff names must be printable text" ;;
    esac
  done

  local repo_root wt_path task_file state_file
  repo_root="$(primary_worktree_root "$repo_arg")"
  [ -n "$repo_root" ] || machine_error "$as_json" "state" "not inside a git repository: ${repo_arg}"
  resolve_worktree_path "$target" "$repo_root" ||
    machine_error "$as_json" "state" "${RESOLVE_WORKTREE_ERROR:-worktree not found: $target}"
  wt_path="$RESOLVED_WORKTREE_PATH"
  task_file="${wt_path}/.worktree-task.md"
  [ -f "$task_file" ] || machine_error "$as_json" "state" "missing task file: ${task_file}"
  state_file="$(task_state_path "$task_file")" ||
    machine_error "$as_json" "state" "unsupported state_file in ${task_file}"
  ensure_task_state "$task_file" "$state_file"
  require_valid_state "$as_json" "state" "$state_file"
  warn_ignored_legacy_fields "$task_file"

  state_begin_update "$state_file"
  if [ -n "$stage" ]; then
    state_set_string "$STATE_UPDATE_FILE" "stage" "$stage"
    if [ "$stage" = "done" ]; then
      state_set_string "$STATE_UPDATE_FILE" "status" "done"
    else
      state_set_string "$STATE_UPDATE_FILE" "status" "ready"
    fi
  fi
  [ -z "$role" ] || state_set_string "$STATE_UPDATE_FILE" "role" "$role"
  [ -z "$agent" ] || state_set_string "$STATE_UPDATE_FILE" "agent" "$agent"
  [ -z "$attempt" ] || state_set_number "$STATE_UPDATE_FILE" "attempt" "$attempt"
  if [ "$handoff_from_set" = true ]; then
    [ "$handoff_from" = "none" ] && handoff_from=""
    state_set_string "$STATE_UPDATE_FILE" "handoff_from" "$handoff_from"
  fi
  if [ "$handoff_to_set" = true ]; then
    [ "$handoff_to" = "none" ] && handoff_to=""
    state_set_string "$STATE_UPDATE_FILE" "handoff_to" "$handoff_to"
  fi
  state_set_string "$STATE_UPDATE_FILE" "updated_at" "$(utc_now)"
  state_commit_update "$state_file"

  if [ "$as_json" = true ]; then
    local current_attempt
    current_attempt="$(state_get "$state_file" "attempt")"
    [ -n "$current_attempt" ] || current_attempt=0
    printf '{"protocol_version":1,"command":"state","ok":true,"worktree":%s,"task_file":%s,"state_file":%s,"stage":%s,"role":%s,"agent":%s,"attempt":%s}\n' \
      "$(json_field "$wt_path")" "$(json_field "$task_file")" "$(json_field "$state_file")" \
      "$(json_field "$(state_get "$state_file" "stage")")" \
      "$(json_field "$(state_get "$state_file" "role")")" \
      "$(json_field "$(state_get "$state_file" "agent")")" \
      "$current_attempt"
  else
    echo "Updated task state: ${state_file}"
  fi
}

cmd_new() {
  local repo_arg="."
  local explicit_base=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo)
        [ $# -ge 2 ] || die "--repo requires a path"
        repo_arg="$2"
        shift 2
        ;;
      --base)
        [ $# -ge 2 ] || die "--base requires a branch or ref"
        explicit_base="$2"
        shift 2
        ;;
      --*)
        die "unknown new option: $1"
        ;;
      *)
        break
        ;;
    esac
  done
  [ $# -eq 1 ] || die "new expects exactly one argument: <type/name>"
  local branch="$1"
  local repo_root base_branch wt_path
  ensure_git_path "$repo_arg"
  repo_root="$(primary_worktree_root "$repo_arg")"
  # Without this, resolve_base_branch names a branch that has no commit behind
  # it and `git worktree add` aborts with a bare `fatal: invalid reference`.
  # `agent init` works in a plain directory, so reaching `new` right after a
  # fresh `git init` is now an ordinary path rather than a corner case.
  git -C "$repo_root" rev-parse --verify HEAD >/dev/null 2>&1 || die \
"repository has no commits yet: ${repo_root}
wtcraft branches a worktree off a base branch, which does not exist until the first commit.
  git commit --allow-empty -m 'initial commit'"
  base_branch="$(resolve_base_branch "$repo_root" "$explicit_base")"
  wt_path="${repo_root}/worktrees/${branch}"

  [ ! -e "$wt_path" ] || die "worktree path already exists: ${wt_path}"
  git -C "$repo_root" show-ref --verify --quiet "refs/heads/${branch}" && die "branch already exists: ${branch}"

  mkdir -p "${repo_root}/worktrees"
  git -C "$repo_root" worktree add "$wt_path" -b "$branch" "$base_branch"

  local task_file="${wt_path}/.worktree-task.md"
  local state_file="${wt_path}/.worktree-state.json"

  # If /planwt already generated a plan in the repo root, absorb it;
  # otherwise seed with the blank template.
  if [ -f "${repo_root}/.worktree-task.md" ]; then
    mv "${repo_root}/.worktree-task.md" "$task_file"
  else
    cp "${TEMPLATE_DIR}/worktrees/.worktree-task.md" "$task_file"
  fi

  local today
  today="$(date +%F)"
  set_frontmatter "$task_file" "task_id" "$branch"
  set_frontmatter "$task_file" "branch" "$branch"
  set_frontmatter "$task_file" "created" "$today"
  set_frontmatter "$task_file" "base" "$base_branch"
  set_frontmatter "$task_file" "state_file" ".worktree-state.json"

  # Absorb legacy lifecycle/result frontmatter into the sidecar before making
  # the Markdown a stable task specification.
  ensure_task_state "$task_file" "$state_file"
  remove_task_state_frontmatter "$task_file"
  ensure_task_state_notice "$task_file"

  cat <<EOF
Created worktree:
  ${wt_path}
Created task specification:
  ${task_file}
Created task state:
  ${state_file}
EOF
}

collect_section_items() {
  local file="$1"
  local section="$2"
  awk -v section="$section" '
    BEGIN { in_section=0 }
    $0 ~ "^##[[:space:]]+" section "$" { in_section=1; next }
    in_section==1 && $0 ~ "^##[[:space:]]+" { in_section=0 }
    in_section==1 {
      line=$0
      gsub(/^[[:space:]]*-[[:space:]]*/, "", line)
      gsub(/`/, "", line)
      gsub(/[[:space:]]+$/, "", line)
      if (line != "" && line !~ /^#/) print line
    }
  ' "$file"
}

collect_verification_commands() {
  local file="$1"
  awk '
    BEGIN { in_section=0 }
    /^##[[:space:]]+Verification$/ { in_section=1; next }
    in_section==1 && /^##[[:space:]]+/ { in_section=0 }
    in_section==1 {
      line=$0
      if (line ~ /^[[:space:]]*-[[:space:]]*\[[ xX]\][[:space:]]+/) {
        sub(/^[[:space:]]*-[[:space:]]*\[[ xX]\][[:space:]]+/, "", line)
        gsub(/`/, "", line)
        gsub(/[[:space:]]+$/, "", line)
        if (line != "") print line
      }
    }
  ' "$file"
}

RESOLVED_WORKTREE_PATH=""
RESOLVE_WORKTREE_ERROR=""

resolve_worktree_path() {
  local arg="$1"
  local repo_root="$2"
  RESOLVED_WORKTREE_PATH=""
  RESOLVE_WORKTREE_ERROR=""
  if [ -d "$arg" ]; then
    RESOLVED_WORKTREE_PATH="$(cd "$arg" && pwd)"
    return 0
  fi
  if [ -d "${repo_root}/worktrees/${arg}" ]; then
    RESOLVED_WORKTREE_PATH="${repo_root}/worktrees/${arg}"
    return 0
  fi
  # Fall back to git's worktree registry: any layout (in-repo, sibling,
  # agent-created arbitrary paths). Branch is the authoritative key, so try
  # an exact branch match first; only then fall back to a basename match.
  local wt branch flags
  local branch_hit="" suffix_hits=()
  while IFS= read -r -d '' wt && IFS= read -r -d '' branch && IFS= read -r -d '' flags; do
    [ -z "$wt" ] && continue
    [ "$wt" = "$repo_root" ] && continue
    [[ "$flags" == *prunable,* ]] && continue
    if [ "$branch" = "$arg" ]; then
      branch_hit="$wt"
      break
    fi
    [ "$(basename "$wt")" = "$arg" ] && suffix_hits+=("$wt")
  done < <(list_worktrees "$repo_root")

  if [ -n "$branch_hit" ]; then
    RESOLVED_WORKTREE_PATH="$branch_hit"
    return 0
  fi
  case "${#suffix_hits[@]}" in
    0) RESOLVE_WORKTREE_ERROR="worktree not found: $arg"; return 1 ;;
    1) RESOLVED_WORKTREE_PATH="${suffix_hits[0]}"; return 0 ;;
    *) RESOLVE_WORKTREE_ERROR="ambiguous worktree '${arg}': matches $(printf '%s ' "${suffix_hits[@]}")- disambiguate by branch name or full path"; return 1 ;;
  esac
}

# file_matches_scope_item <file> <pattern>
#
# Returns 0 (match) when the file path satisfies the pattern, 1 otherwise.
#
# Pattern types:
#   No wildcard  — exact match OR directory-prefix match (pattern/ prefix)
#   With *       — bash glob matching; * matches any chars including '/'
#                  so src/*.ts also matches src/sub/dir/file.ts
#                  and *.md matches docs/readme.md at any depth
file_matches_scope_item() {
  local file="$1"
  local pattern="$2"
  [ -z "$pattern" ] && return 1

  # No wildcards: exact or directory-prefix match (original behaviour)
  if [[ "$pattern" != *"*"* ]]; then
    local prefix="${pattern%/}"
    [ "$file" = "$prefix" ] && return 0
    [[ "$file" == "$prefix/"* ]] && return 0
    return 1
  fi

  # Glob pattern: in bash [[ ]], * matches any characters including '/'
  # This makes src/*.ts, src/**/*.ts, and *.md all work as expected.
  # shellcheck disable=SC2053
  [[ "$file" == $pattern ]] && return 0
  return 1
}

cmd_check() {
  local as_json=false
  local repo_arg="."
  while [ $# -gt 0 ]; do
    case "$1" in
      --json)
        as_json=true
        shift
        ;;
      --repo)
        [ $# -ge 2 ] || machine_error "$as_json" "check" "--repo requires a path"
        repo_arg="$2"
        shift 2
        ;;
      --*)
        machine_error "$as_json" "check" "unknown check option: $1"
        ;;
      *)
        break
        ;;
    esac
  done
  [ $# -eq 1 ] || machine_error "$as_json" "check" "check expects exactly one argument"

  local repo_root
  repo_root="$(primary_worktree_root "$repo_arg")"
  if [ -z "$repo_root" ]; then
    if [ "$as_json" = true ]; then
      machine_error "$as_json" "check" "not inside a git repository: ${repo_arg}"
    fi
    die "not inside a git repository: ${repo_arg}"
  fi

  local wt_path
  resolve_worktree_path "$1" "$repo_root" ||
    machine_error "$as_json" "check" "${RESOLVE_WORKTREE_ERROR:-worktree not found: $1}"
  wt_path="$RESOLVED_WORKTREE_PATH"

  local task_file="${wt_path}/.worktree-task.md"
  if [ ! -f "$task_file" ]; then
    if [ "$as_json" = true ]; then
      machine_error "$as_json" "check" "missing task file: ${task_file}"
    fi
    die "missing task file: ${task_file}"
  fi
  local state_file
  state_file="$(task_state_path "$task_file")" ||
    machine_error "$as_json" "check" "unsupported state_file in ${task_file}"
  ensure_task_state "$task_file" "$state_file"
  require_valid_state "$as_json" "check" "$state_file"
  warn_ignored_legacy_fields "$task_file"

  local base_branch
  base_branch="$(extract_frontmatter "$task_file" "base")"
  base_branch="${base_branch:-$(resolve_base_branch "$repo_root")}"

  local changed_files=()
  local scope_items=()
  local offlimits_items=()
  local violation_objects=()
  local line
  local changed_file_list
  changed_file_list="$(mktemp)"

  # Committed changes vs base, plus staged/unstaged edits and untracked files —
  # agents often leave work uncommitted, and a gate that only sees commits has a hole.
  if ! {
    git -C "$wt_path" diff --name-only -z "${base_branch}...HEAD" &&
      git -C "$wt_path" diff --name-only -z HEAD &&
      git -C "$wt_path" ls-files -z --others --exclude-standard \
        --exclude=.worktree-task.md --exclude=.worktree-state.json \
        --exclude='.worktree-state.json.*'
  } >"$changed_file_list"; then
    rm -f "$changed_file_list"
    machine_error "$as_json" "check" "failed to enumerate changed files against base: ${base_branch}"
  fi
  while IFS= read -r -d '' line; do
    local already_seen=0
    local existing
    for existing in "${changed_files[@]:-}"; do
      if [ "$existing" = "$line" ]; then
        already_seen=1
        break
      fi
    done
    [ "$already_seen" -eq 0 ] && changed_files+=("$line")
  done <"$changed_file_list"
  rm -f "$changed_file_list"

  while IFS= read -r line; do
    scope_items+=("$line")
  done < <(collect_section_items "$task_file" "Scope")

  while IFS= read -r line; do
    offlimits_items+=("$line")
  done < <(collect_section_items "$task_file" "Off-limits")

  local has_violations=0

  for f in "${changed_files[@]:-}"; do
    [ -z "$f" ] && continue
    if [ "$f" = ".worktree-task.md" ] || [ "$f" = ".worktree-state.json" ]; then
      local task_msg="Local task-file violation: ${f} must not be committed or merged."
      [ "$as_json" = false ] && echo "$task_msg"
      violation_objects+=("{\"kind\":\"local_task_file\",\"file\":$(json_field "$f"),\"matched\":null,\"message\":$(json_field "$task_msg")}")
      has_violations=1
      continue
    fi

    local in_scope=0
    for s in "${scope_items[@]:-}"; do
      [ -z "$s" ] && continue
      if file_matches_scope_item "$f" "$s"; then
        in_scope=1
        break
      fi
    done
    if [ "${#scope_items[@]}" -gt 0 ] && [ "$in_scope" -eq 0 ]; then
      local scope_msg="Scope violation: ${f}"
      [ "$as_json" = false ] && echo "$scope_msg"
      violation_objects+=("{\"kind\":\"scope\",\"file\":$(json_field "$f"),\"matched\":null,\"message\":$(json_field "$scope_msg")}")
      has_violations=1
    fi

    for o in "${offlimits_items[@]:-}"; do
      [ -z "$o" ] && continue
      if file_matches_scope_item "$f" "$o"; then
        local offlimits_msg="Off-limits violation: ${f} (matched ${o})"
        [ "$as_json" = false ] && echo "$offlimits_msg"
        violation_objects+=("{\"kind\":\"off_limits\",\"file\":$(json_field "$f"),\"matched\":$(json_field "$o"),\"message\":$(json_field "$offlimits_msg")}")
        has_violations=1
      fi
    done
  done

  local summary_result="pass"
  local exit_code=0
  if [ "$has_violations" -ne 0 ]; then
    summary_result="fail"
    exit_code=2
  fi
  local checked_at check_snapshot
  checked_at="$(utc_now)"
  check_snapshot="$(worktree_snapshot "$wt_path")"
  state_begin_update "$state_file"
  state_set_string "$STATE_UPDATE_FILE" "check_result" "$summary_result"
  state_set_string "$STATE_UPDATE_FILE" "checked" "$checked_at"
  state_set_string "$STATE_UPDATE_FILE" "check_snapshot" "$check_snapshot"
  state_set_string "$STATE_UPDATE_FILE" "updated_at" "$checked_at"
  state_commit_update "$state_file"

  if [ "$as_json" = true ]; then
    printf '{"protocol_version":1,"command":"check","ok":true,"result":"%s","exit_code":%s,"repo_root":%s,"worktree":%s,"task_file":%s,"state_file":%s,"snapshot":%s,"base":%s,"changed_files":%s,"scope":%s,"off_limits":%s,"violations":%s,"summary":{"violation_count":%s}}\n' \
      "$summary_result" \
      "$exit_code" \
      "$(json_field "$repo_root")" \
      "$(json_field "$wt_path")" \
      "$(json_field "$task_file")" \
      "$(json_field "$state_file")" \
      "$(json_field "$check_snapshot")" \
      "$(json_field "$base_branch")" \
      "$(json_string_array "${changed_files[@]:-}")" \
      "$(json_string_array "${scope_items[@]:-}")" \
      "$(json_string_array "${offlimits_items[@]:-}")" \
      "$(json_object_array "${violation_objects[@]:-}")" \
      "${#violation_objects[@]}"
  fi

  if [ "$has_violations" -eq 0 ]; then
    if [ "$as_json" = false ]; then
      echo "Check passed: no Scope/Off-limits violations in commits since ${base_branch} or the working tree."
    fi
    return 0
  else
    exit 2
  fi
}

cmd_verify() {
  local as_json=false
  local repo_arg="."
  while [ $# -gt 0 ]; do
    case "$1" in
      --json)
        as_json=true
        shift
        ;;
      --repo)
        [ $# -ge 2 ] || machine_error "$as_json" "verify" "--repo requires a path"
        repo_arg="$2"
        shift 2
        ;;
      --*)
        machine_error "$as_json" "verify" "unknown verify option: $1"
        ;;
      *)
        break
        ;;
    esac
  done
  [ $# -eq 1 ] || machine_error "$as_json" "verify" "verify expects exactly one argument"

  local repo_root
  repo_root="$(primary_worktree_root "$repo_arg")"
  if [ -z "$repo_root" ]; then
    if [ "$as_json" = true ]; then
      machine_error "$as_json" "verify" "not inside a git repository: ${repo_arg}"
    fi
    die "not inside a git repository: ${repo_arg}"
  fi

  local wt_path
  resolve_worktree_path "$1" "$repo_root" ||
    machine_error "$as_json" "verify" "${RESOLVE_WORKTREE_ERROR:-worktree not found: $1}"
  wt_path="$RESOLVED_WORKTREE_PATH"

  local task_file="${wt_path}/.worktree-task.md"
  if [ ! -f "$task_file" ]; then
    if [ "$as_json" = true ]; then
      machine_error "$as_json" "verify" "missing task file: ${task_file}"
    fi
    die "missing task file: ${task_file}"
  fi
  local state_file
  state_file="$(task_state_path "$task_file")" ||
    machine_error "$as_json" "verify" "unsupported state_file in ${task_file}"
  ensure_task_state "$task_file" "$state_file"
  require_valid_state "$as_json" "verify" "$state_file"
  warn_ignored_legacy_fields "$task_file"

  local commands=()
  local line
  while IFS= read -r line; do
    commands+=("$line")
  done < <(collect_verification_commands "$task_file")

  if [ "${#commands[@]}" -eq 0 ]; then
    if [ "$as_json" = true ]; then
      machine_error "$as_json" "verify" "no verification commands found in ${task_file}"
    fi
    die "no verification commands found in ${task_file}"
  fi

  local failures=0
  local total="${#commands[@]}"
  local result_lines=()
  local result_objects=()
  local i=0

  for cmd in "${commands[@]}"; do
    i=$((i + 1))
    local start=$SECONDS
    if [ "$as_json" = false ]; then
      echo ""
      echo "[${i}/${total}] Running: ${cmd}"
      echo "----------------------------------------------------------------"
    fi
    set +e
    if [ "$as_json" = true ]; then
      (cd "$wt_path" && bash -lc "$cmd") >&2
    else
      (cd "$wt_path" && bash -lc "$cmd")
    fi
    local command_exit_code=$?
    set -e
    local elapsed=$((SECONDS - start))
    [ "$as_json" = false ] && echo "----------------------------------------------------------------"
    if [ "$command_exit_code" -ne 0 ]; then
      failures=$((failures + 1))
      [ "$as_json" = false ] && echo "FAILED (exit ${command_exit_code}, ${elapsed}s)"
      result_lines+=("  FAIL  [exit ${command_exit_code}] (${elapsed}s)  ${cmd}")
      result_objects+=("{\"index\":${i},\"command\":$(json_field "$cmd"),\"status\":\"fail\",\"exit_code\":${command_exit_code},\"duration_seconds\":${elapsed}}")
    else
      [ "$as_json" = false ] && echo "PASSED (${elapsed}s)"
      result_lines+=("  PASS  [exit 0]       (${elapsed}s)  ${cmd}")
      result_objects+=("{\"index\":${i},\"command\":$(json_field "$cmd"),\"status\":\"pass\",\"exit_code\":0,\"duration_seconds\":${elapsed}}")
    fi
  done

  if [ "$as_json" = false ]; then
    echo ""
    echo "================================================================"
    echo "Verification summary: $((total - failures)) passed, ${failures} failed of ${total}"
    echo "================================================================"
    for r in "${result_lines[@]}"; do
      echo "$r"
    done
    echo "================================================================"
  fi

  local result="pass"
  [ "$failures" -ne 0 ] && result="fail"
  local verified_at verify_snapshot
  verified_at="$(utc_now)"
  verify_snapshot="$(worktree_snapshot "$wt_path")"
  state_begin_update "$state_file"
  state_set_string "$STATE_UPDATE_FILE" "verify_result" "$result"
  state_set_string "$STATE_UPDATE_FILE" "verified" "$verified_at"
  state_set_string "$STATE_UPDATE_FILE" "verify_snapshot" "$verify_snapshot"
  state_set_string "$STATE_UPDATE_FILE" "updated_at" "$verified_at"
  state_commit_update "$state_file"
  [ "$as_json" = false ] && echo "Recorded verification result in ${state_file}"

  if [ "$as_json" = true ]; then
    local final_exit_code=0
    [ "$failures" -ne 0 ] && final_exit_code=3
    printf '{"protocol_version":1,"command":"verify","ok":true,"result":"%s","exit_code":%s,"repo_root":%s,"worktree":%s,"task_file":%s,"state_file":%s,"snapshot":%s,"verify_result":%s,"verified":%s,"results":%s,"summary":{"total":%s,"passed":%s,"failed":%s}}\n' \
      "$result" \
      "$final_exit_code" \
      "$(json_field "$repo_root")" \
      "$(json_field "$wt_path")" \
      "$(json_field "$task_file")" \
      "$(json_field "$state_file")" \
      "$(json_field "$verify_snapshot")" \
      "$(json_field "$result")" \
      "$(json_field "$verified_at")" \
      "$(json_object_array "${result_objects[@]:-}")" \
      "$total" \
      "$((total - failures))" \
      "$failures"
  fi

  if [ "$failures" -ne 0 ]; then
    if [ "$as_json" = false ]; then
      echo ""
      echo "Verification FAILED: ${failures} of ${total} command(s) failed."
    fi
    exit 3
  fi

  if [ "$as_json" = false ]; then
    echo ""
    echo "Verification PASSED: all ${total} command(s) succeeded."
  fi
  return 0
}

cmd_capabilities() {
  local as_json=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) as_json=true ;;
      *) die "unknown capabilities option: $1" ;;
    esac
    shift
  done

  [ "$as_json" = true ] || die "capabilities currently requires --json"

  printf '{"protocol_version":1,"cli_version":%s,"commands":{"status":{"json":true,"success_shape":"array","supports_repo_option":true},"state":{"json":true,"success_shape":"object","supports_repo_option":true},"check":{"json":true,"success_shape":"object","supports_repo_option":true,"exit_codes":[0,2]},"verify":{"json":true,"success_shape":"object","supports_repo_option":true,"exit_codes":[0,3]},"init":{"supports_repo_option":true},"init-ci":{"supports_repo_option":true},"new":{"supports_repo_option":true,"supports_base_option":true}},"repository_targeting":{"option":"--repo","registry_commands":["status","state","check","verify","new"]},"machine_output":{"stdout":"json only in --json mode","stderr":"human diagnostics and child command output","json_errors":true}}\n' \
    "$(json_field "$(read_cli_version)")"
}

cmd_doctor() {
  local cli_path cli_version
  cli_path="$(command -v wtcraft || echo "$0")"
  cli_version="$(read_cli_version)"
  echo "CLI path: $cli_path"
  echo "Version: ${cli_version}"

  local other_installs
  other_installs="$(type -a wtcraft 2>/dev/null | grep -v " is $cli_path" | awk '{print $3}' | sort -u || true)"
  if [ -n "$other_installs" ]; then
    echo "Other installations:"
    for inst in $other_installs; do
      local inst_ver
      inst_ver="$("$inst" --version 2>/dev/null || echo "unknown")"
      if [ -z "$inst_ver" ]; then inst_ver="unknown"; fi
      echo "  $inst ($inst_ver)"
    done

    if echo "$other_installs" | grep -iq "homebrew"; then
       if echo "$cli_path" | grep -iq -e "pipx" -e "\.local/bin"; then
         echo "Warning: a pipx installation shadows Homebrew"
       fi
    fi
  fi

  echo ""
  echo "Checking repository context..."
  if git rev-parse --show-toplevel >/dev/null 2>&1; then
    local repo_root
    repo_root="$(git rev-parse --show-toplevel)"

    local missing=0
    for file in .agent-harness/planner.md .agent-harness/executor.md .agent-harness/finisher.md .agent-harness/role-models.yml .claude/commands/planwt.md; do
      if [ ! -f "$repo_root/$file" ]; then
        echo "Missing scaffold: $file"
        missing=$((missing + 1))
      fi
    done
    if [ "$missing" -eq 0 ]; then
      echo "Scaffold files: Complete"
    fi

    if [ -f "$repo_root/.worktree-task.template.md" ]; then
      echo "Legacy file detected: .worktree-task.template.md (run 'wtcraft migrate' to fix)"
    fi

    if [ -f "$repo_root/.agent-harness/executor.md" ]; then
      if ! git -C "$repo_root" check-ignore -q .worktree-state.json 2>/dev/null; then
        echo "Warning: .worktree-state.json is not ignored (run 'wtcraft init' to add the rule)"
      fi
      if ! grep -qF 'wtcraft state' "$repo_root/.agent-harness/executor.md"; then
        echo "Warning: .agent-harness/ predates the state sidecar. Its guidance writes lifecycle into .worktree-task.md, which wtcraft ignores once .worktree-state.json exists. Replace it with ${TEMPLATE_DIR}/.agent-harness/"
      fi
    fi
  else
    echo "Not inside a git repository."
  fi

  echo ""
  echo "Checking environment..."
  local cred_helper
  cred_helper="$(git config --get credential.helper || echo "None")"
  echo "Git credential helper: $cred_helper"

  if [ ! -d "$TEMPLATE_DIR" ] || [ -z "$(ls -A "$TEMPLATE_DIR" 2>/dev/null)" ]; then
    echo "Warning: Template directory '$TEMPLATE_DIR' is missing or empty."
  else
    echo "Template directory: Complete ($TEMPLATE_DIR)"
  fi
}

cmd_migrate() {
  local auto_yes=false
  local repo_arg="."
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes) auto_yes=true ;;
      --repo) shift; repo_arg="${1:?--repo requires a path}" ;;
      *) die "unknown migrate option: $1" ;;
    esac
    shift
  done
  local repo_root
  repo_root="$(project_root "$repo_arg")"

  echo "Running wtcraft init to ensure all scaffolds are present..."
  cmd_init --repo "$repo_root"

  if [ -f "$repo_root/.worktree-task.template.md" ]; then
    if [ "$auto_yes" = true ]; then
      rm -f "$repo_root/.worktree-task.template.md"
      echo "Deleted .worktree-task.template.md"
    elif [ -t 0 ]; then
      echo ""
      read -r -p "Delete legacy file '.worktree-task.template.md'? [y/N] " response
      case "$response" in
        [yY][eE][sS]|[yY])
          rm -f "$repo_root/.worktree-task.template.md"
          echo "Deleted .worktree-task.template.md"
          ;;
        *)
          echo "Skipped deletion."
          ;;
      esac
    else
      echo "Legacy file detected: .worktree-task.template.md"
      echo "Run with --yes to delete automatically."
    fi
  else
    echo "No legacy files to migrate."
  fi
}

main() {
  [ $# -ge 1 ] || { usage; exit 1; }
  local cmd="$1"
  shift

  case "$cmd" in
    agent)       cmd_agent "$@" ;;
    init)        cmd_init "$@" ;;
    init-ci)     cmd_init_ci "$@" ;;
    patch)       cmd_patch "$@" ;;
    unpatch)     cmd_unpatch "$@" ;;
    lang)        cmd_lang "$@" ;;
    status)      cmd_status "$@" ;;
    state)       cmd_state "$@" ;;
    new)         cmd_new "$@" ;;
    check)       cmd_check "$@" ;;
    verify)      cmd_verify "$@" ;;
    capabilities) cmd_capabilities "$@" ;;
    doctor)      cmd_doctor "$@" ;;
    migrate)     cmd_migrate "$@" ;;
    help)        cmd_help "$@" ;;
    version|--version) printf '%s\n' "$(read_cli_version)" ;;
    -h|--help)   usage ;;
    *) usage; die "unknown command: ${cmd}" ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
