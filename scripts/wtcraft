#!/usr/bin/env bash
set -euo pipefail

# Resolve symlinks so this works when installed as a global npm/homebrew symlink
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SELF_DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
ROOT_DIR="$(cd "${SELF_DIR}/.." && pwd)"
# WTCRAFT_TEMPLATE_DIR overrides the default; pip/Homebrew installs set this.
TEMPLATE_DIR="${WTCRAFT_TEMPLATE_DIR:-${ROOT_DIR}/templates}"

usage() {
  cat <<'EOF'
wtcraft - git-native harness helper

Usage:
  wtcraft agent init [--path <path>]
  wtcraft init [--patch-agent-files] [--local] [--repo <path>]
  wtcraft patch [--repo <path>]
  wtcraft unpatch [--repo <path>]
  wtcraft lang install [--repo <path>] [--lang <code>]
  wtcraft lang remove [--repo <path>]
  wtcraft status [--json] [--repo <path>]
  wtcraft new [--repo <path>] <type/name>
  wtcraft check [--json] [--repo <path>] <worktree-path-or-name>
  wtcraft verify [--json] [--repo <path>] <worktree-path-or-name>
  wtcraft capabilities --json
  wtcraft doctor
  wtcraft migrate [--yes]
  wtcraft --version
  wtcraft help [command]
EOF
}

usage_agent() {
  cat <<'EOF'
wtcraft agent init [--path <path>]

  Initialize shared coding-agent instructions in a project directory.
  Git is not required.

  AGENTS.md is the canonical instruction file. CLAUDE.md imports it with
  @AGENTS.md so shared instructions only need to be maintained once.
  Existing content is never overwritten, and re-running is idempotent.

  Options:
    --path <path>   Target a project directory instead of the current one

  Creates when missing:
    AGENTS.md
    CLAUDE.md
EOF
}

usage_init() {
  cat <<'EOF'
wtcraft init [--patch-agent-files] [--local] [--repo <path>]

  Scaffold harness files into the current project directory.
  Git is not required unless --local is used.
  Existing files are never overwritten.

  Options:
    --patch-agent-files   Append a wtcraft routing stub to CLAUDE.md and
                          AGENTS.md (opt-in only; never overwrites content)
    --local               Keep wtcraft scaffold local to this clone by
                          writing ignore rules to .git/info/exclude instead
                          of modifying the repo's .gitignore
    --repo <path>         Target a specific project directory instead of relying
                          on the current working directory

  Creates:
    .agent-harness/planner.md
    .agent-harness/executor.md
    .agent-harness/finisher.md
    .agent-harness/role-models.yml
    .agent-harness/task-states.md
    .agent-harness/presets/
    .claude/commands/planwt.md
    .claude/commands/finishwt.md
EOF
}

usage_patch() {
  cat <<'EOF'
wtcraft patch [--repo <path>]

  Explicit alias for `wtcraft init --patch-agent-files`.
  Scaffolds harness files (if missing) and appends the managed wtcraft
  routing stub to CLAUDE.md and AGENTS.md. Idempotent and append-only:
  existing content is never overwritten, and re-running is a no-op.

  Reverse with: wtcraft unpatch
EOF
}

usage_unpatch() {
  cat <<'EOF'
wtcraft unpatch [--repo <path>]

  Remove the managed wtcraft routing stub previously added by
  `wtcraft patch` (or `init --patch-agent-files`) from CLAUDE.md and
  AGENTS.md. Only the content between the wtcraft markers is removed;
  the rest of each file is left untouched. Scaffolded harness files
  (.agent-harness/, .claude/commands/) are NOT removed.
EOF
}

usage_lang() {
  cat <<'EOF'
wtcraft lang install [--repo <path>] [--lang <code>]
wtcraft lang remove [--repo <path>]

  Install or remove a language-enforcement stub in the agent files
  (CLAUDE.md and AGENTS.md). The stub instructs the AI to respond only
  in the specified language.

  Only agent files that already exist are patched; this command never
  creates one. If neither CLAUDE.md nor AGENTS.md exists, run
  'wtcraft agent init' first to create them.

  Subcommands:
    install   Append a language-enforcement block to each existing
              agent file (idempotent)
    remove    Strip the language-enforcement block from both agent files

  Options for install:
    --lang <code>   Language to enforce (default: en)
                    en     — English only
                    zh-CN  — Simplified Chinese or English

  This stub is separate from the wtcraft routing stub (wtcraft patch/unpatch)
  and is an opt-in feature for users who need strict language output control.
EOF
}

usage_status() {
  cat <<'EOF'
wtcraft status [--json] [--repo <path>]

  List all linked worktrees with their task contract state. Worktrees are
  enumerated via `git worktree list`, so any layout is covered (in-repo
  worktrees/, sibling dirs, agent-created arbitrary paths).

  --json emits one object per worktree: worktree, branch, zombie, locked,
  contracted, and (when contracted) task_file, stage (with legacy status
  fallback applied), role, agent, status, priority, created, base,
  verify_result, verified. Absent fields are null. Intended as the stable
  machine interface for external observers/GUIs.
  --repo <path> explicitly targets a repository; registry commands normalize
  linked worktrees to the repository's primary worktree root.

  Columns: task file, stage (falls back to legacy `status:` for contracts
  that predate the stage convention — see .agent-harness/task-states.md),
  role, agent, priority, verification result.

  Worktrees without a `.worktree-task.md` are listed as `uncontracted`;
  registry entries whose directory was deleted show as `zombie`.
EOF
}

usage_new() {
  cat <<'EOF'
wtcraft new [--repo <path>] [--base <branch>] <type/name>

  Create a new git worktree from the base branch and seed it with a
  .worktree-task.md contract file.

  Arguments:
    <type/name>   Branch and worktree path (e.g. feat/auth-refactor)

  Options:
    --repo <path>    Target a specific repository explicitly
    --base <branch>  Override the base branch/ref for this worktree creation

  Environment:
    WTCRAFT_BASE_BRANCH   Base branch/ref to branch from when --base is not
                          provided

  Default base detection:
    1. `origin/HEAD`
    2. local `main`
    3. local `master`
    4. local `develop`
    5. current branch
EOF
}

usage_check() {
  cat <<'EOF'
wtcraft check [--json] [--repo <path>] <worktree-path-or-name>

  Compare files changed in the worktree against the Scope and Off-limits
  sections of the .worktree-task.md contract. Covers commits since the base
  branch, staged/unstaged edits, and untracked files. The task contract
  itself (.worktree-task.md) is exempt.

  Scope pattern syntax:
    - Exact file path:      src/index.ts
    - Directory prefix:     src/components  (matches anything under it)
    - Glob (* any chars):   *.md, src/*.ts  (* matches path separators too)
    - Recursive glob:       src/**/*.ts

  Exit codes:
    0   No violations detected
    2   One or more Scope or Off-limits violations found

  --json emits a stable machine-readable object to stdout while preserving
  the same exit codes. Diagnostics remain on stderr.
EOF
}

usage_verify() {
  cat <<'EOF'
wtcraft verify [--json] [--repo <path>] <worktree-path-or-name>

  Run verification commands listed in the Verification section of the
  .worktree-task.md contract. Each command runs inside the worktree directory.

  Output includes per-command timing, exit codes, and a summary table.
  The result is written back to the task file frontmatter as
  `verify_result: pass|fail` and `verified: <timestamp>`, which
  `wtcraft status` reports in its Verified column.

  Exit codes:
    0   All commands passed
    3   One or more commands failed

  --json emits a stable machine-readable object to stdout while preserving
  the same exit codes. Verification command output remains on stderr.
EOF
}

usage_capabilities() {
  cat <<'EOF'
wtcraft capabilities --json

  Report the machine-protocol features supported by this wtcraft build.
  The current output format is JSON-only and is intended for GUI/TUI
  launchers that need capability discovery before invocation.
EOF
}

usage_doctor() {
  cat <<'EOF'
wtcraft doctor

  Diagnose the current wtcraft installation and repository scaffold.

  Reports:
    - CLI path and version
    - other wtcraft installations on PATH (shadow detection)
    - scaffold file completeness (when inside a git repository)
    - legacy file detection (.worktree-task.template.md)
    - template directory status
    - git credential helper
EOF
}

usage_migrate() {
  cat <<'EOF'
wtcraft migrate [--yes]

  Ensure all scaffold files are present and remove legacy files.

  Runs `wtcraft init` to fill in any missing scaffold, then offers to
  delete known legacy files such as .worktree-task.template.md.

  Options:
    --yes   Skip the interactive confirmation prompt and delete legacy
            files automatically. Useful for CI and scripted usage.
EOF
}

cmd_help() {
  if [ $# -eq 0 ]; then
    usage
    return 0
  fi
  case "$1" in
    agent)   usage_agent ;;
    init)    usage_init ;;
    patch)   usage_patch ;;
    unpatch) usage_unpatch ;;
    lang)    usage_lang ;;
    status)  usage_status ;;
    new)     usage_new ;;
    check)   usage_check ;;
    verify)  usage_verify ;;
    capabilities) usage_capabilities ;;
    doctor)  usage_doctor ;;
    migrate) usage_migrate ;;
    version) usage ;;
    help)    usage ;;
    *) die "no help topic for: $1" ;;
  esac
}

die() {
  echo "Error: $*" >&2
  exit 1
}

read_cli_version() {
  # Installers stamp WTCRAFT_VERSION (brew wrapper, pip _cli.py) so the version
  # survives even when no manifest sits beside the installed script.
  if [ -n "${WTCRAFT_VERSION:-}" ]; then
    printf '%s' "${WTCRAFT_VERSION}"
    return 0
  fi
  # In-repo development: read it straight from the manifest next to the script.
  if [ -f "${ROOT_DIR}/package.json" ]; then
    awk -F'"' '/"version"[[:space:]]*:/ { print $4; exit }' "${ROOT_DIR}/package.json"
    return 0
  fi
  if [ -f "${ROOT_DIR}/pyproject.toml" ]; then
    awk -F'"' '/^version[[:space:]]*=/ { print $2; exit }' "${ROOT_DIR}/pyproject.toml"
    return 0
  fi
  printf 'unknown'
}

current_worktree_root() {
  local path="${1:-.}"
  git -C "$path" rev-parse --show-toplevel 2>/dev/null
}

primary_worktree_root() {
  local path="${1:-.}"
  git -C "$path" worktree list --porcelain 2>/dev/null | awk '
    /^worktree / {
      sub(/^worktree /, "", $0)
      print
      exit
    }
  '
}

resolve_base_branch() {
  local repo_root="$1"
  local explicit_base="${2:-}"
  if [ -n "$explicit_base" ]; then
    printf '%s' "$explicit_base"
    return 0
  fi

  if [ -n "${WTCRAFT_BASE_BRANCH:-}" ]; then
    printf '%s' "${WTCRAFT_BASE_BRANCH}"
    return 0
  fi

  local candidate
  candidate="$(git -C "$repo_root" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  if [ -n "$candidate" ]; then
    printf '%s' "$candidate"
    return 0
  fi

  for candidate in main master develop; do
    if git -C "$repo_root" show-ref --verify --quiet "refs/heads/${candidate}"; then
      printf '%s' "$candidate"
      return 0
    fi
  done

  candidate="$(git -C "$repo_root" branch --show-current 2>/dev/null || true)"
  if [ -n "$candidate" ]; then
    printf '%s' "$candidate"
    return 0
  fi

  die "could not determine a base branch; set WTCRAFT_BASE_BRANCH explicitly"
}

git_info_exclude_path() {
  local path="${1:-.}"
  git -C "$path" rev-parse --git-path info/exclude 2>/dev/null
}

ensure_git_path() {
  local path="${1:-.}"
  git -C "$path" rev-parse --show-toplevel >/dev/null 2>&1 || die "not inside a git repository: ${path}"
}

directory_root() {
  local path="${1:-.}"
  [ -d "$path" ] || die "project directory does not exist: ${path}"
  (cd "$path" && pwd -P)
}

# Resolve a project root without requiring Git. Inside a repository this keeps
# the existing behavior of targeting the worktree root; elsewhere, the target
# directory itself is the project root.
project_root() {
  local path="${1:-.}"
  [ -d "$path" ] || die "project directory does not exist: ${path}"

  local git_root
  git_root="$(git -C "$path" rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -n "$git_root" ]; then
    printf '%s' "$git_root"
  else
    directory_root "$path"
  fi
}

copy_if_missing() {
  local src="$1"
  local dst="$2"
  if [ -e "$dst" ]; then
    return 0
  fi
  mkdir -p "$(dirname "$dst")"
  cp "$src" "$dst"
}

append_managed_block_if_missing() {
  local file="$1"
  local block="$2"
  local start_marker="$3"

  if [ ! -f "$file" ]; then
    mkdir -p "$(dirname "$file")"
    printf "%s\n" "$block" >"$file"
    echo "Created and patched: ${file}"
    return 0
  fi

  if grep -qF "$start_marker" "$file"; then
    echo "Already patched: ${file}"
    return 0
  fi

  printf "\n%s\n" "$block" >>"$file"
  echo "Patched: ${file}"
}

patch_agent_files() {
  local repo_root="$1"
  local claude_file="${repo_root}/CLAUDE.md"
  local agents_file="${repo_root}/AGENTS.md"

  local claude_start="<!-- wtcraft:claude:start -->"
  local agents_start="<!-- wtcraft:agents:start -->"

  local claude_block
  claude_block="$(cat <<'EOF'
<!-- wtcraft:claude:start -->
## wtcraft routing
For complex or parallel tasks, read `.agent-harness/planner.md`.
For worktree finishing, read `.agent-harness/finisher.md`.
For LLM prompting anti-patterns (e.g., Irony of Negation, Sycophancy), read `.agent-harness/llm-anti-patterns.md`.
<!-- wtcraft:claude:end -->
EOF
)"

  local agents_block
  agents_block="$(cat <<'EOF'
<!-- wtcraft:agents:start -->
## wtcraft routing
If `.worktree-task.md` exists in the current worktree root, read `.agent-harness/executor.md` first and follow task Scope, Off-limits, and Verification.
<!-- wtcraft:agents:end -->
EOF
)"

  append_managed_block_if_missing "$claude_file" "$claude_block" "$claude_start"
  append_managed_block_if_missing "$agents_file" "$agents_block" "$agents_start"
}

remove_managed_block() {
  local file="$1"
  local start_marker="$2"
  local end_marker="$3"

  if [ ! -f "$file" ]; then
    echo "Not found (skipped): ${file}"
    return 0
  fi

  if ! grep -qF "$start_marker" "$file"; then
    echo "No wtcraft stub (skipped): ${file}"
    return 0
  fi

  local tmp
  tmp="$(mktemp)"
  # Drop every line from the start marker through the end marker (inclusive).
  # Lines are buffered one behind so we can also discard the single blank
  # separator line the appender inserts before the block.
  awk -v s="$start_marker" -v e="$end_marker" '
    index($0, s) {
      if (have_prev && prev !~ /^[[:space:]]*$/) print prev
      have_prev = 0
      skip = 1
      next
    }
    skip {
      if (index($0, e)) skip = 0
      next
    }
    { if (have_prev) print prev; prev = $0; have_prev = 1 }
    END { if (have_prev) print prev }
  ' "$file" >"$tmp"

  mv "$tmp" "$file"
  echo "Unpatched: ${file}"
}

unpatch_agent_files() {
  local repo_root="$1"
  remove_managed_block "${repo_root}/CLAUDE.md" \
    "<!-- wtcraft:claude:start -->" "<!-- wtcraft:claude:end -->"
  remove_managed_block "${repo_root}/AGENTS.md" \
    "<!-- wtcraft:agents:start -->" "<!-- wtcraft:agents:end -->"
}

cmd_agent_init() {
  local path_arg="."
  while [ $# -gt 0 ]; do
    case "$1" in
      --path) shift; path_arg="${1:?--path requires a path}" ;;
      *) die "unknown agent init option: $1" ;;
    esac
    shift
  done

  local root agents_file claude_file
  root="$(directory_root "$path_arg")"
  agents_file="${root}/AGENTS.md"
  claude_file="${root}/CLAUDE.md"

  if { [ -e "$agents_file" ] || [ -L "$agents_file" ]; } && [ ! -f "$agents_file" ]; then
    die "AGENTS.md exists but is not a regular file: ${agents_file}"
  fi
  if { [ -e "$claude_file" ] || [ -L "$claude_file" ]; } && [ ! -f "$claude_file" ]; then
    die "CLAUDE.md exists but is not a regular file: ${claude_file}"
  fi

  if [ ! -e "$agents_file" ]; then
    printf '# Project Instructions\n' >"$agents_file"
    echo "Created: ${agents_file}"
  else
    echo "Existing content preserved: ${agents_file}"
  fi

  if [ ! -e "$claude_file" ]; then
    printf '@AGENTS.md\n' >"$claude_file"
    echo "Created with AGENTS.md import: ${claude_file}"
  elif grep -Eq '(^|[[:space:]])@(\./)?AGENTS\.md([[:space:]]|$)' "$claude_file"; then
    echo "AGENTS.md import already present: ${claude_file}"
  else
    if [ -s "$claude_file" ]; then
      printf '\n@AGENTS.md\n' >>"$claude_file"
    else
      printf '@AGENTS.md\n' >>"$claude_file"
    fi
    echo "Added AGENTS.md import: ${claude_file}"
  fi
}

cmd_agent() {
  [ $# -ge 1 ] || { usage_agent; exit 1; }
  local subcmd="$1"
  shift
  case "$subcmd" in
    init) cmd_agent_init "$@" ;;
    -h|--help|help) usage_agent ;;
    *) die "unknown agent subcommand: ${subcmd}. Use init" ;;
  esac
}

cmd_init() {
  local patch_agent=false
  local local_mode=false
  local repo_arg="."
  while [ $# -gt 0 ]; do
    case "$1" in
      --patch-agent-files) patch_agent=true ;;
      --local) local_mode=true ;;
      --repo) shift; repo_arg="${1:?--repo requires a path}" ;;
      *) die "unknown init option: $1" ;;
    esac
    shift
  done

  local repo_root
  if [ "$local_mode" = true ]; then
    ensure_git_path "$repo_arg"
  fi
  repo_root="$(project_root "$repo_arg")"

  copy_if_missing "${TEMPLATE_DIR}/.agent-harness/planner.md" "${repo_root}/.agent-harness/planner.md"
  copy_if_missing "${TEMPLATE_DIR}/.agent-harness/executor.md" "${repo_root}/.agent-harness/executor.md"
  copy_if_missing "${TEMPLATE_DIR}/.agent-harness/finisher.md" "${repo_root}/.agent-harness/finisher.md"
  copy_if_missing "${TEMPLATE_DIR}/.agent-harness/role-models.yml" "${repo_root}/.agent-harness/role-models.yml"
  copy_if_missing "${TEMPLATE_DIR}/.agent-harness/task-states.md" "${repo_root}/.agent-harness/task-states.md"
  copy_if_missing "${TEMPLATE_DIR}/.agent-harness/llm-anti-patterns.md" "${repo_root}/.agent-harness/llm-anti-patterns.md"
  copy_if_missing "${TEMPLATE_DIR}/.claude/commands/planwt.md" "${repo_root}/.claude/commands/planwt.md"
  copy_if_missing "${TEMPLATE_DIR}/.claude/commands/finishwt.md" "${repo_root}/.claude/commands/finishwt.md"
  copy_if_missing "${TEMPLATE_DIR}/.claude/commands/statuswt.md" "${repo_root}/.claude/commands/statuswt.md"
  
  for preset in balanced anthropic openai google; do
    copy_if_missing "${TEMPLATE_DIR}/.agent-harness/presets/preset-${preset}.yml" "${repo_root}/.agent-harness/presets/preset-${preset}.yml"
  done

  if [ "$local_mode" = true ]; then
    local exclude_file
    exclude_file="$(git_info_exclude_path "$repo_root")"
    [ -n "$exclude_file" ] || die "failed to resolve .git/info/exclude for ${repo_root}"
    mkdir -p "$(dirname "$exclude_file")"
    [ -f "$exclude_file" ] || : >"$exclude_file"
    if ! grep -qxF '# wtcraft local scaffold' "$exclude_file"; then
      printf '\n# wtcraft local scaffold\n' >>"$exclude_file"
    fi
    local local_rule
    for local_rule in \
      '/.worktree-task.md' \
      '/.agent-harness/' \
      '/.claude/commands/' \
      '/AGENTS.md' \
      '/CLAUDE.md'
    do
      if ! grep -qxF "$local_rule" "$exclude_file"; then
        printf '%s\n' "$local_rule" >>"$exclude_file"
      fi
    done
  else
    # Ensure .worktree-task.md is ignored in the user's repo
    local gitignore="${repo_root}/.gitignore"
    if [ ! -f "$gitignore" ] || ! grep -qxF '/.worktree-task.md' "$gitignore"; then
      printf '\n# wtcraft local task state\n/.worktree-task.md\n' >> "$gitignore"
    fi
  fi

  cat <<'EOF'
 Initialized wtcraft harness files (existing files were left untouched):
   .agent-harness/planner.md
   .agent-harness/executor.md
   .agent-harness/finisher.md
   .agent-harness/role-models.yml
   .agent-harness/task-states.md
   .agent-harness/llm-anti-patterns.md
   .agent-harness/presets/
   .claude/commands/planwt.md
   .claude/commands/finishwt.md
   .claude/commands/statuswt.md
EOF

  if [ "$patch_agent" = true ]; then
    echo
    echo "Applying optional routing stubs to agent files..."
    patch_agent_files "$repo_root"
  else
    echo
    echo "Agent files were not modified (default behavior)."
    echo "Use: wtcraft init --patch-agent-files"
  fi

  if [ "$local_mode" = true ]; then
    echo
    echo "Local mode enabled: wtcraft scaffold is ignored via .git/info/exclude in this clone only."
  fi

  echo
  echo "Initialized wtcraft harness using wtcraft $(read_cli_version)"
  if [ -f "${repo_root}/.worktree-task.template.md" ]; then
    echo
    echo "Legacy scaffold detected: .worktree-task.template.md"
    echo "Run: wtcraft migrate"
  fi
}

cmd_patch() {
  cmd_init --patch-agent-files "$@"
}

cmd_unpatch() {
  local repo_arg="."
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) shift; repo_arg="${1:?--repo requires a path}" ;;
      *) die "unknown unpatch option: $1" ;;
    esac
    shift
  done
  local repo_root
  repo_root="$(project_root "$repo_arg")"
  echo "Removing wtcraft routing stubs from agent files..."
  unpatch_agent_files "$repo_root"
}

cmd_lang() {
  [ $# -ge 1 ] || { usage_lang; exit 1; }
  local subcmd="$1"; shift
  local repo_arg="."
  local remaining=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) shift; repo_arg="${1:?--repo requires a path}" ;;
      *) remaining+=("$1") ;;
    esac
    shift
  done
  local repo_root
  repo_root="$(project_root "$repo_arg")"
  local claude_file="${repo_root}/CLAUDE.md"
  local agents_file="${repo_root}/AGENTS.md"
  set -- ${remaining[@]+"${remaining[@]}"}

  case "$subcmd" in
    install)
      local lang="en"
      while [ $# -gt 0 ]; do
        case "$1" in
          --lang) shift; lang="${1:?--lang requires a value}"; shift ;;
          *) die "unknown lang install option: $1" ;;
        esac
      done

      local lang_block
      case "$lang" in
        en)
          lang_block="$(cat <<'EOF'
<!-- wtcraft:lang:start -->
## Language Enforcement
CRITICAL: Output YOUR ENTIRE RESPONSE in **English** only.
<!-- wtcraft:lang:end -->
EOF
)"
          ;;
        zh-CN)
          lang_block="$(cat <<'EOF'
<!-- wtcraft:lang:start -->
## Language Enforcement
CRITICAL: Output YOUR ENTIRE RESPONSE in **Simplified Chinese (简体中文)** or English only.
<!-- wtcraft:lang:end -->
EOF
)"
          ;;
        *)
          die "unsupported language code: ${lang}. Supported: en, zh-CN"
          ;;
      esac

      # Patch only the agent files that already exist; never conjure one.
      # CLAUDE.md and AGENTS.md are created by `wtcraft patch`.
      if [ ! -f "$claude_file" ] && [ ! -f "$agents_file" ]; then
        die "no CLAUDE.md or AGENTS.md in ${repo_root}. Run 'wtcraft agent init' first, then re-run lang install."
      fi
      if [ -f "$claude_file" ]; then
        append_managed_block_if_missing "$claude_file" "$lang_block" "<!-- wtcraft:lang:start -->"
      fi
      if [ -f "$agents_file" ]; then
        append_managed_block_if_missing "$agents_file" "$lang_block" "<!-- wtcraft:lang:start -->"
      fi
      ;;
    remove)
      [ $# -eq 0 ] || die "lang remove takes no arguments"
      remove_managed_block "$claude_file" \
        "<!-- wtcraft:lang:start -->" "<!-- wtcraft:lang:end -->"
      remove_managed_block "$agents_file" \
        "<!-- wtcraft:lang:start -->" "<!-- wtcraft:lang:end -->"
      ;;
    *)
      die "unknown lang subcommand: ${subcmd}. Use install or remove"
      ;;
  esac
}

extract_frontmatter() {
  local file="$1"
  local key="$2"
  awk -v key="$key" '
    BEGIN { in_fm=0 }
    /^---$/ {
      if (in_fm==0) { in_fm=1; next }
      else { in_fm=0; exit }
    }
    in_fm==1 {
      if ($0 ~ "^" key ":") {
        sub("^" key ":[[:space:]]*", "", $0)
        print $0
        exit
      }
    }
  ' "$file"
}

# set_frontmatter <file> <key> <value>
#
# Update key in the frontmatter block, or insert it before the closing ---
# when absent. Only the first frontmatter block is touched.
set_frontmatter() {
  local file="$1"
  local key="$2"
  local value="$3"
  local tmp="${file}.tmp"
  awk -v key="$key" -v value="$value" '
    BEGIN { in_fm=0; fm_done=0; written=0 }
    /^---$/ {
      if (fm_done==0 && in_fm==0) { in_fm=1; print; next }
      if (in_fm==1) {
        if (written==0) { print key ": " value; written=1 }
        in_fm=0; fm_done=1; print; next
      }
      print; next
    }
    in_fm==1 && written==0 && $0 ~ "^" key ":" { print key ": " value; written=1; next }
    { print }
  ' "$file" > "$tmp" && mv "$tmp" "$file"
}

# list_worktrees <repo_root>
#
# Emit NUL-delimited triples: worktree-path, branch, flags. Git's `-z` output
# keeps paths containing newlines intact; this parser must remain NUL-based
# end-to-end.
list_worktrees() {
  local repo_root="$1"
  local field wt="" branch="" flags=""
  while IFS= read -r -d '' field; do
    if [ -z "$field" ]; then
      if [ -n "$wt" ]; then
        printf '%s\0%s\0%s\0' "$wt" "$branch" "$flags"
      fi
      wt=""
      branch=""
      flags=""
      continue
    fi
    case "$field" in
      "worktree "*) wt="${field#worktree }" ;;
      "branch refs/heads/"*) branch="${field#branch refs/heads/}" ;;
      prunable*) flags="${flags}prunable," ;;
      locked*) flags="${flags}locked," ;;
    esac
  done < <(git -C "$repo_root" worktree list --porcelain -z)
  if [ -n "$wt" ]; then
    printf '%s\0%s\0%s\0' "$wt" "$branch" "$flags"
  fi
}

json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  local code octal char escaped
  code=1
  while [ "$code" -le 31 ]; do
    printf -v octal '%03o' "$code"
    printf -v char '%b' "\\${octal}"
    printf -v escaped '\\u%04x' "$code"
    s="${s//$char/$escaped}"
    code=$((code + 1))
  done
  printf '%s' "$s"
}

# json_field <value> — quoted JSON string, or null when empty
json_field() {
  if [ -z "$1" ]; then
    printf 'null'
  else
    printf '"%s"' "$(json_escape "$1")"
  fi
}

json_error_object() {
  local command="$1"
  local code="$2"
  local message="$3"
  printf '{"protocol_version":1,"command":"%s","ok":false,"error":{"code":%s,"message":"%s"}}\n' \
    "$(json_escape "$command")" \
    "$code" \
    "$(json_escape "$message")"
}

machine_error() {
  local as_json="$1"
  local command="$2"
  local message="$3"
  if [ "$as_json" = true ]; then
    json_error_object "$command" 1 "$message"
    exit 1
  fi
  die "$message"
}

json_string_array() {
  local out="[" first=1 item
  for item in "$@"; do
    [ -z "$item" ] && continue
    if [ "$first" -eq 1 ]; then
      out="${out}$(json_field "$item")"
      first=0
    else
      out="${out},$(json_field "$item")"
    fi
  done
  printf '%s]' "$out"
}

json_object_array() {
  local out="[" first=1 item
  for item in "$@"; do
    [ -z "$item" ] && continue
    if [ "$first" -eq 1 ]; then
      out="${out}${item}"
      first=0
    else
      out="${out},${item}"
    fi
  done
  printf '%s]' "$out"
}

cmd_status() {
  local as_json=false
  local repo_arg="."
  while [ $# -gt 0 ]; do
    case "$1" in
      --json)
        as_json=true
        shift
        ;;
      --repo)
        [ $# -ge 2 ] || machine_error "$as_json" "status" "--repo requires a path"
        repo_arg="$2"
        shift 2
        ;;
      --*)
        machine_error "$as_json" "status" "unknown status option: $1"
        ;;
      *)
        break
        ;;
    esac
  done
  [ $# -eq 0 ] || machine_error "$as_json" "status" "status takes no positional arguments"
  local repo_root
  repo_root="$(primary_worktree_root "$repo_arg")"
  if [ -z "$repo_root" ]; then
    if [ "$as_json" = true ]; then
      machine_error "$as_json" "status" "not inside a git repository: ${repo_arg}"
    fi
    die "not inside a git repository: ${repo_arg}"
  fi

  if [ "$as_json" = false ]; then
    printf "%-45s %-13s %-10s %-8s %-8s %-10s\n" "Worktree / Task" "Stage" "Role" "Agent" "Priority" "Verified"
    printf "%-45s %-13s %-10s %-8s %-8s %-10s\n" "---------------" "-----" "----" "-----" "--------" "--------"
  fi

  local found=0 wt branch flags
  local json_entries=()
  while IFS= read -r -d '' wt && IFS= read -r -d '' branch && IFS= read -r -d '' flags; do
    [ -z "$wt" ] && continue
    # Skip the primary worktree (repo root), keep only linked worktrees.
    [ "$wt" = "$repo_root" ] && continue
    found=1
    local rel="$wt"
    case "$wt" in
      "$repo_root"/*) rel="${wt#"${repo_root}"/}" ;;
    esac

    local zombie=false locked=false contracted=false
    [[ "$flags" == *prunable,* ]] && zombie=true
    [[ "$flags" == *locked,* ]] && locked=true

    local task="${wt}/.worktree-task.md"
    local stage="" status_legacy="" role="" agent="" priority="" created="" base="" verify_result="" verified=""
    if [ "$zombie" = false ] && [ -f "$task" ]; then
      contracted=true
      stage="$(extract_frontmatter "$task" "stage")"
      status_legacy="$(extract_frontmatter "$task" "status")"
      # Legacy contracts predate stage:; fall back to the coarse status field.
      [ -n "$stage" ] || stage="$status_legacy"
      role="$(extract_frontmatter "$task" "role")"
      agent="$(extract_frontmatter "$task" "agent")"
      priority="$(extract_frontmatter "$task" "priority")"
      created="$(extract_frontmatter "$task" "created")"
      base="$(extract_frontmatter "$task" "base")"
      verify_result="$(extract_frontmatter "$task" "verify_result")"
      verified="$(extract_frontmatter "$task" "verified")"
    fi

    if [ "$as_json" = true ]; then
      local entry
      entry="{\"repo_root\":$(json_field "$repo_root"),\"worktree\":$(json_field "$wt"),\"branch\":$(json_field "$branch"),\"zombie\":${zombie},\"locked\":${locked},\"contracted\":${contracted}"
      if [ "$contracted" = true ]; then
        entry="${entry},\"task_file\":$(json_field "$task"),\"stage\":$(json_field "$stage"),\"role\":$(json_field "$role"),\"agent\":$(json_field "$agent"),\"status\":$(json_field "$status_legacy"),\"priority\":$(json_field "$priority"),\"created\":$(json_field "$created"),\"base\":$(json_field "$base"),\"verify_result\":$(json_field "$verify_result"),\"verified\":$(json_field "$verified")"
      fi
      json_entries+=("${entry}}")
      continue
    fi

    if [ "$zombie" = true ]; then
      printf "%-45s %-13s %-10s %-8s %-8s %-10s\n" "$rel" "zombie" "-" "-" "-" "-"
    elif [ "$contracted" = false ]; then
      printf "%-45s %-13s %-10s %-8s %-8s %-10s\n" "$rel" "uncontracted" "-" "-" "-" "-"
    else
      printf "%-45s %-13s %-10s %-8s %-8s %-10s\n" \
        "${rel}/.worktree-task.md" "${stage:-unknown}" "${role:--}" \
        "${agent:-unknown}" "${priority:-unknown}" "${verify_result:--}"
    fi
  done < <(list_worktrees "$repo_root")

  if [ "$as_json" = true ]; then
    json_object_array "${json_entries[@]:-}"
    printf '\n'
    return 0
  fi

  if [ "$found" -eq 0 ]; then
    echo "No linked worktrees found."
  fi
}

cmd_new() {
  local repo_arg="."
  local explicit_base=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo)
        [ $# -ge 2 ] || die "--repo requires a path"
        repo_arg="$2"
        shift 2
        ;;
      --base)
        [ $# -ge 2 ] || die "--base requires a branch or ref"
        explicit_base="$2"
        shift 2
        ;;
      --*)
        die "unknown new option: $1"
        ;;
      *)
        break
        ;;
    esac
  done
  [ $# -eq 1 ] || die "new expects exactly one argument: <type/name>"
  local branch="$1"
  local repo_root base_branch wt_path
  ensure_git_path "$repo_arg"
  repo_root="$(primary_worktree_root "$repo_arg")"
  # Without this, resolve_base_branch names a branch that has no commit behind
  # it and `git worktree add` aborts with a bare `fatal: invalid reference`.
  # `agent init` works in a plain directory, so reaching `new` right after a
  # fresh `git init` is now an ordinary path rather than a corner case.
  git -C "$repo_root" rev-parse --verify HEAD >/dev/null 2>&1 || die \
"repository has no commits yet: ${repo_root}
wtcraft branches a worktree off a base branch, which does not exist until the first commit.
  git commit --allow-empty -m 'initial commit'"
  base_branch="$(resolve_base_branch "$repo_root" "$explicit_base")"
  wt_path="${repo_root}/worktrees/${branch}"

  [ ! -e "$wt_path" ] || die "worktree path already exists: ${wt_path}"
  git -C "$repo_root" show-ref --verify --quiet "refs/heads/${branch}" && die "branch already exists: ${branch}"

  mkdir -p "${repo_root}/worktrees"
  git -C "$repo_root" worktree add "$wt_path" -b "$branch" "$base_branch"

  local task_file="${wt_path}/.worktree-task.md"

  # If /planwt already generated a plan in the repo root, absorb it;
  # otherwise seed with the blank template.
  if [ -f "${repo_root}/.worktree-task.md" ]; then
    mv "${repo_root}/.worktree-task.md" "$task_file"
  else
    cp "${TEMPLATE_DIR}/worktrees/.worktree-task.md" "$task_file"
  fi

  local today
  today="$(date +%F)"
  set_frontmatter "$task_file" "branch" "$branch"
  set_frontmatter "$task_file" "created" "$today"
  set_frontmatter "$task_file" "base" "$base_branch"

  # Plans absorbed from /planwt may predate the stage/role convention.
  [ -n "$(extract_frontmatter "$task_file" "stage")" ] || set_frontmatter "$task_file" "stage" "planned"
  [ -n "$(extract_frontmatter "$task_file" "role")" ] || set_frontmatter "$task_file" "role" "executor"

  cat <<EOF
Created worktree:
  ${wt_path}
Created task contract:
  ${task_file}
EOF
}

collect_section_items() {
  local file="$1"
  local section="$2"
  awk -v section="$section" '
    BEGIN { in_section=0 }
    $0 ~ "^##[[:space:]]+" section "$" { in_section=1; next }
    in_section==1 && $0 ~ "^##[[:space:]]+" { in_section=0 }
    in_section==1 {
      line=$0
      gsub(/^[[:space:]]*-[[:space:]]*/, "", line)
      gsub(/`/, "", line)
      gsub(/[[:space:]]+$/, "", line)
      if (line != "" && line !~ /^#/) print line
    }
  ' "$file"
}

collect_verification_commands() {
  local file="$1"
  awk '
    BEGIN { in_section=0 }
    /^##[[:space:]]+Verification$/ { in_section=1; next }
    in_section==1 && /^##[[:space:]]+/ { in_section=0 }
    in_section==1 {
      line=$0
      if (line ~ /^[[:space:]]*-[[:space:]]*\[[ xX]\][[:space:]]+/) {
        sub(/^[[:space:]]*-[[:space:]]*\[[ xX]\][[:space:]]+/, "", line)
        gsub(/`/, "", line)
        gsub(/[[:space:]]+$/, "", line)
        if (line != "") print line
      }
    }
  ' "$file"
}

RESOLVED_WORKTREE_PATH=""
RESOLVE_WORKTREE_ERROR=""

resolve_worktree_path() {
  local arg="$1"
  local repo_root="$2"
  RESOLVED_WORKTREE_PATH=""
  RESOLVE_WORKTREE_ERROR=""
  if [ -d "$arg" ]; then
    RESOLVED_WORKTREE_PATH="$(cd "$arg" && pwd)"
    return 0
  fi
  if [ -d "${repo_root}/worktrees/${arg}" ]; then
    RESOLVED_WORKTREE_PATH="${repo_root}/worktrees/${arg}"
    return 0
  fi
  # Fall back to git's worktree registry: any layout (in-repo, sibling,
  # agent-created arbitrary paths). Branch is the authoritative key, so try
  # an exact branch match first; only then fall back to a basename match.
  local wt branch flags
  local branch_hit="" suffix_hits=()
  while IFS= read -r -d '' wt && IFS= read -r -d '' branch && IFS= read -r -d '' flags; do
    [ -z "$wt" ] && continue
    [ "$wt" = "$repo_root" ] && continue
    [[ "$flags" == *prunable,* ]] && continue
    if [ "$branch" = "$arg" ]; then
      branch_hit="$wt"
      break
    fi
    [ "$(basename "$wt")" = "$arg" ] && suffix_hits+=("$wt")
  done < <(list_worktrees "$repo_root")

  if [ -n "$branch_hit" ]; then
    RESOLVED_WORKTREE_PATH="$branch_hit"
    return 0
  fi
  case "${#suffix_hits[@]}" in
    0) RESOLVE_WORKTREE_ERROR="worktree not found: $arg"; return 1 ;;
    1) RESOLVED_WORKTREE_PATH="${suffix_hits[0]}"; return 0 ;;
    *) RESOLVE_WORKTREE_ERROR="ambiguous worktree '${arg}': matches $(printf '%s ' "${suffix_hits[@]}")- disambiguate by branch name or full path"; return 1 ;;
  esac
}

# file_matches_scope_item <file> <pattern>
#
# Returns 0 (match) when the file path satisfies the pattern, 1 otherwise.
#
# Pattern types:
#   No wildcard  — exact match OR directory-prefix match (pattern/ prefix)
#   With *       — bash glob matching; * matches any chars including '/'
#                  so src/*.ts also matches src/sub/dir/file.ts
#                  and *.md matches docs/readme.md at any depth
file_matches_scope_item() {
  local file="$1"
  local pattern="$2"
  [ -z "$pattern" ] && return 1

  # No wildcards: exact or directory-prefix match (original behaviour)
  if [[ "$pattern" != *"*"* ]]; then
    local prefix="${pattern%/}"
    [ "$file" = "$prefix" ] && return 0
    [[ "$file" == "$prefix/"* ]] && return 0
    return 1
  fi

  # Glob pattern: in bash [[ ]], * matches any characters including '/'
  # This makes src/*.ts, src/**/*.ts, and *.md all work as expected.
  # shellcheck disable=SC2053
  [[ "$file" == $pattern ]] && return 0
  return 1
}

cmd_check() {
  local as_json=false
  local repo_arg="."
  while [ $# -gt 0 ]; do
    case "$1" in
      --json)
        as_json=true
        shift
        ;;
      --repo)
        [ $# -ge 2 ] || machine_error "$as_json" "check" "--repo requires a path"
        repo_arg="$2"
        shift 2
        ;;
      --*)
        machine_error "$as_json" "check" "unknown check option: $1"
        ;;
      *)
        break
        ;;
    esac
  done
  [ $# -eq 1 ] || machine_error "$as_json" "check" "check expects exactly one argument"

  local repo_root
  repo_root="$(primary_worktree_root "$repo_arg")"
  if [ -z "$repo_root" ]; then
    if [ "$as_json" = true ]; then
      machine_error "$as_json" "check" "not inside a git repository: ${repo_arg}"
    fi
    die "not inside a git repository: ${repo_arg}"
  fi

  local wt_path
  resolve_worktree_path "$1" "$repo_root" ||
    machine_error "$as_json" "check" "${RESOLVE_WORKTREE_ERROR:-worktree not found: $1}"
  wt_path="$RESOLVED_WORKTREE_PATH"

  local task_file="${wt_path}/.worktree-task.md"
  if [ ! -f "$task_file" ]; then
    if [ "$as_json" = true ]; then
      machine_error "$as_json" "check" "missing task file: ${task_file}"
    fi
    die "missing task file: ${task_file}"
  fi

  local base_branch
  base_branch="$(extract_frontmatter "$task_file" "base")"
  base_branch="${base_branch:-$(resolve_base_branch "$repo_root")}"

  local changed_files=()
  local scope_items=()
  local offlimits_items=()
  local violation_objects=()
  local line
  local changed_file_list
  changed_file_list="$(mktemp)"

  # Committed changes vs base, plus staged/unstaged edits and untracked files —
  # agents often leave work uncommitted, and a gate that only sees commits has a hole.
  if ! {
    git -C "$wt_path" diff --name-only -z "${base_branch}...HEAD" &&
      git -C "$wt_path" diff --name-only -z HEAD &&
      git -C "$wt_path" ls-files -z --others --exclude-standard
  } >"$changed_file_list"; then
    rm -f "$changed_file_list"
    machine_error "$as_json" "check" "failed to enumerate changed files against base: ${base_branch}"
  fi
  while IFS= read -r -d '' line; do
    local already_seen=0
    local existing
    for existing in "${changed_files[@]:-}"; do
      if [ "$existing" = "$line" ]; then
        already_seen=1
        break
      fi
    done
    [ "$already_seen" -eq 0 ] && changed_files+=("$line")
  done <"$changed_file_list"
  rm -f "$changed_file_list"

  while IFS= read -r line; do
    scope_items+=("$line")
  done < <(collect_section_items "$task_file" "Scope")

  while IFS= read -r line; do
    offlimits_items+=("$line")
  done < <(collect_section_items "$task_file" "Off-limits")

  local has_violations=0

  for f in "${changed_files[@]:-}"; do
    [ -z "$f" ] && continue
    if [ "$f" = ".worktree-task.md" ]; then
      local task_msg="Task contract violation: .worktree-task.md is local worktree state and must not be committed or merged."
      [ "$as_json" = false ] && echo "$task_msg"
      violation_objects+=("{\"kind\":\"task_contract\",\"file\":$(json_field "$f"),\"matched\":null,\"message\":$(json_field "$task_msg")}")
      has_violations=1
      continue
    fi

    local in_scope=0
    for s in "${scope_items[@]:-}"; do
      [ -z "$s" ] && continue
      if file_matches_scope_item "$f" "$s"; then
        in_scope=1
        break
      fi
    done
    if [ "${#scope_items[@]}" -gt 0 ] && [ "$in_scope" -eq 0 ]; then
      local scope_msg="Scope violation: ${f}"
      [ "$as_json" = false ] && echo "$scope_msg"
      violation_objects+=("{\"kind\":\"scope\",\"file\":$(json_field "$f"),\"matched\":null,\"message\":$(json_field "$scope_msg")}")
      has_violations=1
    fi

    for o in "${offlimits_items[@]:-}"; do
      [ -z "$o" ] && continue
      if file_matches_scope_item "$f" "$o"; then
        local offlimits_msg="Off-limits violation: ${f} (matched ${o})"
        [ "$as_json" = false ] && echo "$offlimits_msg"
        violation_objects+=("{\"kind\":\"off_limits\",\"file\":$(json_field "$f"),\"matched\":$(json_field "$o"),\"message\":$(json_field "$offlimits_msg")}")
        has_violations=1
      fi
    done
  done

  if [ "$as_json" = true ]; then
    local summary_result="pass"
    local exit_code=0
    if [ "$has_violations" -ne 0 ]; then
      summary_result="fail"
      exit_code=2
    fi
    printf '{"protocol_version":1,"command":"check","ok":true,"result":"%s","exit_code":%s,"repo_root":%s,"worktree":%s,"task_file":%s,"base":%s,"changed_files":%s,"scope":%s,"off_limits":%s,"violations":%s,"summary":{"violation_count":%s}}\n' \
      "$summary_result" \
      "$exit_code" \
      "$(json_field "$repo_root")" \
      "$(json_field "$wt_path")" \
      "$(json_field "$task_file")" \
      "$(json_field "$base_branch")" \
      "$(json_string_array "${changed_files[@]:-}")" \
      "$(json_string_array "${scope_items[@]:-}")" \
      "$(json_string_array "${offlimits_items[@]:-}")" \
      "$(json_object_array "${violation_objects[@]:-}")" \
      "${#violation_objects[@]}"
  fi

  if [ "$has_violations" -eq 0 ]; then
    if [ "$as_json" = false ]; then
      echo "Check passed: no Scope/Off-limits violations in commits since ${base_branch} or the working tree."
    fi
    return 0
  else
    exit 2
  fi
}

cmd_verify() {
  local as_json=false
  local repo_arg="."
  while [ $# -gt 0 ]; do
    case "$1" in
      --json)
        as_json=true
        shift
        ;;
      --repo)
        [ $# -ge 2 ] || machine_error "$as_json" "verify" "--repo requires a path"
        repo_arg="$2"
        shift 2
        ;;
      --*)
        machine_error "$as_json" "verify" "unknown verify option: $1"
        ;;
      *)
        break
        ;;
    esac
  done
  [ $# -eq 1 ] || machine_error "$as_json" "verify" "verify expects exactly one argument"

  local repo_root
  repo_root="$(primary_worktree_root "$repo_arg")"
  if [ -z "$repo_root" ]; then
    if [ "$as_json" = true ]; then
      machine_error "$as_json" "verify" "not inside a git repository: ${repo_arg}"
    fi
    die "not inside a git repository: ${repo_arg}"
  fi

  local wt_path
  resolve_worktree_path "$1" "$repo_root" ||
    machine_error "$as_json" "verify" "${RESOLVE_WORKTREE_ERROR:-worktree not found: $1}"
  wt_path="$RESOLVED_WORKTREE_PATH"

  local task_file="${wt_path}/.worktree-task.md"
  if [ ! -f "$task_file" ]; then
    if [ "$as_json" = true ]; then
      machine_error "$as_json" "verify" "missing task file: ${task_file}"
    fi
    die "missing task file: ${task_file}"
  fi

  local commands=()
  local line
  while IFS= read -r line; do
    commands+=("$line")
  done < <(collect_verification_commands "$task_file")

  if [ "${#commands[@]}" -eq 0 ]; then
    if [ "$as_json" = true ]; then
      machine_error "$as_json" "verify" "no verification commands found in ${task_file}"
    fi
    die "no verification commands found in ${task_file}"
  fi

  local failures=0
  local total="${#commands[@]}"
  local result_lines=()
  local result_objects=()
  local i=0

  for cmd in "${commands[@]}"; do
    i=$((i + 1))
    local start=$SECONDS
    if [ "$as_json" = false ]; then
      echo ""
      echo "[${i}/${total}] Running: ${cmd}"
      echo "----------------------------------------------------------------"
    fi
    set +e
    if [ "$as_json" = true ]; then
      (cd "$wt_path" && bash -lc "$cmd") >&2
    else
      (cd "$wt_path" && bash -lc "$cmd")
    fi
    local command_exit_code=$?
    set -e
    local elapsed=$((SECONDS - start))
    [ "$as_json" = false ] && echo "----------------------------------------------------------------"
    if [ "$command_exit_code" -ne 0 ]; then
      failures=$((failures + 1))
      [ "$as_json" = false ] && echo "FAILED (exit ${command_exit_code}, ${elapsed}s)"
      result_lines+=("  FAIL  [exit ${command_exit_code}] (${elapsed}s)  ${cmd}")
      result_objects+=("{\"index\":${i},\"command\":$(json_field "$cmd"),\"status\":\"fail\",\"exit_code\":${command_exit_code},\"duration_seconds\":${elapsed}}")
    else
      [ "$as_json" = false ] && echo "PASSED (${elapsed}s)"
      result_lines+=("  PASS  [exit 0]       (${elapsed}s)  ${cmd}")
      result_objects+=("{\"index\":${i},\"command\":$(json_field "$cmd"),\"status\":\"pass\",\"exit_code\":0,\"duration_seconds\":${elapsed}}")
    fi
  done

  if [ "$as_json" = false ]; then
    echo ""
    echo "================================================================"
    echo "Verification summary: $((total - failures)) passed, ${failures} failed of ${total}"
    echo "================================================================"
    for r in "${result_lines[@]}"; do
      echo "$r"
    done
    echo "================================================================"
  fi

  local result="pass"
  [ "$failures" -ne 0 ] && result="fail"
  local verified_at
  verified_at="$(date +"%Y-%m-%d %H:%M")"
  set_frontmatter "$task_file" "verify_result" "$result"
  set_frontmatter "$task_file" "verified" "$verified_at"
  [ "$as_json" = false ] && echo "Recorded verify_result: ${result} in ${task_file}"

  if [ "$as_json" = true ]; then
    local final_exit_code=0
    [ "$failures" -ne 0 ] && final_exit_code=3
    printf '{"protocol_version":1,"command":"verify","ok":true,"result":"%s","exit_code":%s,"repo_root":%s,"worktree":%s,"task_file":%s,"verify_result":%s,"verified":%s,"results":%s,"summary":{"total":%s,"passed":%s,"failed":%s}}\n' \
      "$result" \
      "$final_exit_code" \
      "$(json_field "$repo_root")" \
      "$(json_field "$wt_path")" \
      "$(json_field "$task_file")" \
      "$(json_field "$result")" \
      "$(json_field "$verified_at")" \
      "$(json_object_array "${result_objects[@]:-}")" \
      "$total" \
      "$((total - failures))" \
      "$failures"
  fi

  if [ "$failures" -ne 0 ]; then
    if [ "$as_json" = false ]; then
      echo ""
      echo "Verification FAILED: ${failures} of ${total} command(s) failed."
    fi
    exit 3
  fi

  if [ "$as_json" = false ]; then
    echo ""
    echo "Verification PASSED: all ${total} command(s) succeeded."
  fi
  return 0
}

cmd_capabilities() {
  local as_json=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) as_json=true ;;
      *) die "unknown capabilities option: $1" ;;
    esac
    shift
  done

  [ "$as_json" = true ] || die "capabilities currently requires --json"

  printf '{"protocol_version":1,"cli_version":%s,"commands":{"status":{"json":true,"success_shape":"array","supports_repo_option":true},"check":{"json":true,"success_shape":"object","supports_repo_option":true,"exit_codes":[0,2]},"verify":{"json":true,"success_shape":"object","supports_repo_option":true,"exit_codes":[0,3]},"init":{"supports_repo_option":true},"new":{"supports_repo_option":true,"supports_base_option":true}},"repository_targeting":{"option":"--repo","registry_commands":["status","check","verify","new"]},"machine_output":{"stdout":"json only in --json mode","stderr":"human diagnostics and child command output","json_errors":true}}\n' \
    "$(json_field "$(read_cli_version)")"
}

cmd_doctor() {
  local cli_path cli_version
  cli_path="$(command -v wtcraft || echo "$0")"
  cli_version="$(read_cli_version)"
  echo "CLI path: $cli_path"
  echo "Version: ${cli_version}"

  local other_installs
  other_installs="$(type -a wtcraft 2>/dev/null | grep -v " is $cli_path" | awk '{print $3}' | sort -u || true)"
  if [ -n "$other_installs" ]; then
    echo "Other installations:"
    for inst in $other_installs; do
      local inst_ver
      inst_ver="$("$inst" --version 2>/dev/null || echo "unknown")"
      if [ -z "$inst_ver" ]; then inst_ver="unknown"; fi
      echo "  $inst ($inst_ver)"
    done

    if echo "$other_installs" | grep -iq "homebrew"; then
       if echo "$cli_path" | grep -iq -e "pipx" -e "\.local/bin"; then
         echo "Warning: a pipx installation shadows Homebrew"
       fi
    fi
  fi

  echo ""
  echo "Checking repository context..."
  if git rev-parse --show-toplevel >/dev/null 2>&1; then
    local repo_root
    repo_root="$(git rev-parse --show-toplevel)"

    local missing=0
    for file in .agent-harness/planner.md .agent-harness/executor.md .agent-harness/finisher.md .agent-harness/role-models.yml .claude/commands/planwt.md; do
      if [ ! -f "$repo_root/$file" ]; then
        echo "Missing scaffold: $file"
        missing=$((missing + 1))
      fi
    done
    if [ "$missing" -eq 0 ]; then
      echo "Scaffold files: Complete"
    fi

    if [ -f "$repo_root/.worktree-task.template.md" ]; then
      echo "Legacy file detected: .worktree-task.template.md (run 'wtcraft migrate' to fix)"
    fi
  else
    echo "Not inside a git repository."
  fi

  echo ""
  echo "Checking environment..."
  local cred_helper
  cred_helper="$(git config --get credential.helper || echo "None")"
  echo "Git credential helper: $cred_helper"

  if [ ! -d "$TEMPLATE_DIR" ] || [ -z "$(ls -A "$TEMPLATE_DIR" 2>/dev/null)" ]; then
    echo "Warning: Template directory '$TEMPLATE_DIR' is missing or empty."
  else
    echo "Template directory: Complete ($TEMPLATE_DIR)"
  fi
}

cmd_migrate() {
  local auto_yes=false
  local repo_arg="."
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes) auto_yes=true ;;
      --repo) shift; repo_arg="${1:?--repo requires a path}" ;;
      *) die "unknown migrate option: $1" ;;
    esac
    shift
  done
  local repo_root
  repo_root="$(project_root "$repo_arg")"

  echo "Running wtcraft init to ensure all scaffolds are present..."
  cmd_init --repo "$repo_root"

  if [ -f "$repo_root/.worktree-task.template.md" ]; then
    if [ "$auto_yes" = true ]; then
      rm -f "$repo_root/.worktree-task.template.md"
      echo "Deleted .worktree-task.template.md"
    elif [ -t 0 ]; then
      echo ""
      read -r -p "Delete legacy file '.worktree-task.template.md'? [y/N] " response
      case "$response" in
        [yY][eE][sS]|[yY])
          rm -f "$repo_root/.worktree-task.template.md"
          echo "Deleted .worktree-task.template.md"
          ;;
        *)
          echo "Skipped deletion."
          ;;
      esac
    else
      echo "Legacy file detected: .worktree-task.template.md"
      echo "Run with --yes to delete automatically."
    fi
  else
    echo "No legacy files to migrate."
  fi
}

main() {
  [ $# -ge 1 ] || { usage; exit 1; }
  local cmd="$1"
  shift

  case "$cmd" in
    agent)       cmd_agent "$@" ;;
    init)        cmd_init "$@" ;;
    patch)       cmd_patch "$@" ;;
    unpatch)     cmd_unpatch "$@" ;;
    lang)        cmd_lang "$@" ;;
    status)      cmd_status "$@" ;;
    new)         cmd_new "$@" ;;
    check)       cmd_check "$@" ;;
    verify)      cmd_verify "$@" ;;
    capabilities) cmd_capabilities "$@" ;;
    doctor)      cmd_doctor "$@" ;;
    migrate)     cmd_migrate "$@" ;;
    help)        cmd_help "$@" ;;
    version|--version) printf '%s\n' "$(read_cli_version)" ;;
    -h|--help)   usage ;;
    *) usage; die "unknown command: ${cmd}" ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
